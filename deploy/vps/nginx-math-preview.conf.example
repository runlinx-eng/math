# Math Explorer preview.
# TCP 443 is intentionally not used: the existing Xray service owns it.
# Shared-password login is checked by a localhost-only auth service.

limit_req_zone $binary_remote_addr zone=preview_login:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name math.664357788.xyz;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host:8443$request_uri;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name math.664357788.xyz;

    ssl_certificate /etc/letsencrypt/live/math.664357788.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/math.664357788.xyz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/math-explorer-preview/current;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-cache" always;

    location = /health {
        default_type application/json;
        return 200 '{"app":"math-explorer","status":"ok"}';
    }

    location = /login {
        alias /var/www/math-preview-login/index.html;
        default_type text/html;
    }

    location = /auth/login {
        limit_req zone=preview_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8765/login;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /auth/logout {
        proxy_pass http://127.0.0.1:8765/logout;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /__preview_auth {
        internal;
        proxy_pass http://127.0.0.1:8765/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        auth_request /__preview_auth;
        error_page 401 = @preview_login;
        try_files $uri $uri/ =404;
    }

    location @preview_login {
        return 302 /login?next=$uri;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
