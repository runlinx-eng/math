+++ b/tests/p9-p112s-probability-selection.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {example, inspect} from '../dist/learning/phase5/b22-model.js';
+import {P112S_SOURCES, replayP112SProbabilitySelectionEvidence, submittedP112SProbabilitySelectionEvidence} from '../dist/learning/p112s-probability-selection-evidence.js';
+
+const ordered = value => Array.isArray(value) ? value.map(ordered) :
+  value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])) : value;
+
+for (const {sessionId, index, taskHash} of P112S_SOURCES) {
+  test(`${sessionId}:${index} replays selected outcomes and the exact probability`, () => {
+    const context = {sessionId, index};
+    const task = sessionTaskFor(sessionId, index);
+    const replay = model => replayP112SProbabilitySelectionEvidence(task, model, context);
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), taskHash);
+    const correct = example(task);
+    assert.ok(inspect(task, correct).correct);
+    assert.deepEqual(replay(correct)?.counts, [task.winners.length,task.items.length]);
+    assert.equal(replayP112SProbabilitySelectionEvidence(task, correct, {sessionId, index:-1}), null);
+    const wrong = structuredClone(correct);
+    wrong.prob='0';
+    assert.equal(replay(wrong), null);
+    assert.equal(submittedP112SProbabilitySelectionEvidence(task, correct, {attempts:[{value:wrong}]}, context), null);
+    assert.deepEqual(submittedP112SProbabilitySelectionEvidence(task, correct, {attempts:[{value:structuredClone(correct)}]}, context), replay(correct));
+    const forged = structuredClone(correct);
+    forged.history[0].d.index = '27';
+    assert.equal(replay(forged), null);
+    const tampered=structuredClone(correct);
+    tampered.board.selected.pop();
+    assert.equal(replay(tampered),null);
+  });
+}
