+import {initial, valid} from './phase5/b24-model.js';
+import {hasExactKeys, latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence} from './evidence-contract.js';
+
+export const P115W_SOURCES = Object.freeze([
+  {
+    "sessionId": "turnwalk",
+    "index": 0,
+    "nodeId": "mt_TdV9YGJEoY",
+    "type": "x-p24-walk",
+    "taskHash": "0df0b822cf56061938d9a155446aefb19764f9cb73db2d55a155bfa96385d89a"
+  },
+  {
+    "sessionId": "turnwalk",
+    "index": 1,
+    "nodeId": "mt_TdV9YGJEoY",
+    "type": "x-p24-walk",
+    "taskHash": "9a3780be623dafbb83bf986b6ff10074b1c7d0f1649398e07a3ba0f4446ec97d"
+  },
+  {
+    "sessionId": "turnwalk",
+    "index": 2,
+    "nodeId": "mt_TdV9YGJEoY",
+    "type": "x-p24-walk",
+    "taskHash": "9c5e61c855bacde52c7361eef982006b33bbcf3eb9610ca6bade9bab88509cc5"
+  },
+  {
+    "sessionId": "turnwalk",
+    "index": 3,
+    "nodeId": "mt_TdV9YGJEoY",
+    "type": "x-p24-walk",
+    "taskHash": "3bba93c5d2f89c3bd1867afccf76002bf77181d28d5596582e3081882f3e869f"
+  },
+  {
+    "sessionId": "turnroute",
+    "index": 0,
+    "nodeId": "mt_Y9XKzLrUAZ",
+    "type": "x-p24-walk",
+    "taskHash": "875d239eb587a0ad917620f5e2a7059f407cb390e2fb252fa7982eaaa581b3da"
+  },
+  {
+    "sessionId": "turnroute",
+    "index": 1,
+    "nodeId": "mt_Y9XKzLrUAZ",
+    "type": "x-p24-walk",
+    "taskHash": "47b32cbd622cbb71f42962e3e5668363636c1479d3707302cb3b7411c001e1e4"
+  },
+  {
+    "sessionId": "turnroute",
+    "index": 2,
+    "nodeId": "mt_Y9XKzLrUAZ",
+    "type": "x-p24-walk",
+    "taskHash": "55667f0a0831a39201bdc13e9df8ee975874c6d2fb1d556c71988928730dc726"
+  },
+  {
+    "sessionId": "turnroute",
+    "index": 3,
+    "nodeId": "mt_Y9XKzLrUAZ",
+    "type": "x-p24-walk",
+    "taskHash": "c86c27c9b56076ebd026c8337196b27c16bef0968ffa0e4fdf136ecee0d5dc58"
+  }
+].map(Object.freeze));
+
+function equalsInteger(raw, expected) {
+  const value = raw.trim();
+  const decimal = /^(\d+)(?:\.0+)?$/.exec(value);
+  if (decimal) return BigInt(decimal[1]) === BigInt(expected);
+  const fraction = /^(?:(\d+)\s+)?(\d+)\/(\d+)$/.exec(value);
+  if (!fraction) return false;
+  const denominator = BigInt(fraction[3]);
+  return denominator > 0n && (BigInt(fraction[1] || '0') - BigInt(expected)) * denominator + BigInt(fraction[2]) === 0n;
+}
+
+export function p115wDirectionWalkBinding(task, context) {
+  const row = P115W_SOURCES.find(source => source.sessionId === context?.sessionId && source.index === context?.index);
+  if (!row || !matchesNativeEvidenceTask(task, context, row)) return null;
+  return {nodeId: row.nodeId, kind: 'p115w-direction-walk', method: null, question: '哪个动作改变位置，哪个动作改变朝向？'};
+}
+
+const headings = ['up', 'right', 'down', 'left'];
+const offsets = [[0,1], [1,0], [0,-1], [-1,0]];
+
+function nextState([x,y,heading], action) {
+  if (action === 'L' || action === 'R') return [x,y,(heading + (action === 'R' ? 1 : 3)) % 4];
+  const [dx,dy] = offsets[heading];
+  const sign = action === 'F' ? 1 : -1;
+  return [x + sign * dx, y + sign * dy, heading];
+}
+
+function answersMatch(context, model, operations, states) {
+  const [answer, finalHeading] = model.answers;
+  const degrees = operations.filter(op => op === 'R').length * 90;
+  if (context.sessionId === 'turnwalk') {
+    if (context.index === 1) return degrees === 90 && answer === 'quarter';
+    return equalsInteger(answer, degrees) && (finalHeading === undefined || finalHeading === headings[states.at(-1)[2]]);
+  }
+  if (context.index === 0) return sameEvidence(states[0], states.at(-1)) && answer === 'same';
+  if (context.index === 2) {
+    return operations.every((op,i) => !['L','R'].includes(op) || sameEvidence(states[i].slice(0,2),states[i+1].slice(0,2))) &&
+      answer === 'same';
+  }
+  return equalsInteger(answer, degrees);
+}
+
+export function replayP115WDirectionWalkEvidence(task, model, context) {
+  try {
+    const binding = p115wDirectionWalkBinding(task, context);
+    if (!binding || !hasExactKeys(model, Object.keys(initial(task, 1))) || !valid(task, model) ||
+        model.issue !== '' || Object.keys(model.history).length !== model.history.length) return null;
+
+    const operations = [];
+    const states = [[...task.start]];
+    for (const event of model.history) {
+      if (!hasExactKeys(event, ['a', 'd', 'f']) || !hasExactKeys(event.d, []) || !hasExactKeys(event.f, [])) return null;
+      const action = event.a;
+      if (action === 'reset') {
+        operations.length = 0;
+        states.length = 1;
+      } else if (action === 'undo') {
+        if (operations.length) {
+          operations.pop();
+          states.pop();
+        }
+      } else {
+        if (!['F','B','L','R'].includes(action) || (action === 'B' && !task.allowBack)) return null;
+        const state = nextState(states.at(-1), action);
+        if (state[0] < 0 || state[0] > 4 || state[1] < 0 || state[1] > 4) continue;
+        operations.push(action);
+        states.push(state);
+      }
+    }
+    if (!sameEvidence(operations, task.ops) || !sameEvidence(operations, model.board.ops) ||
+        !sameEvidence(states, model.board.states) || !sameEvidence(states.at(-1), model.board.state) ||
+        !answersMatch(context, model, operations, states)) return null;
+    return {...binding, operations, states};
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP115WDirectionWalkEvidence(task, model, record, context) {
+  return latestSubmissionMatches(model, record) ? replayP115WDirectionWalkEvidence(task, model, context) : null;
+}
diff --git a/tests/p9-p115w-direction-walk-browser.cjs b/tests/p9-p115w-direction-walk-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..1e2ac80036765c63f55b02e831c861882ec758e8
--- /dev/null
+++ b/tests/p9-p115w-direction-walk-browser.cjs
@@ -0,0 +1,162 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P115W_ARTIFACTS || path.join(root, 'verification/p9-p115w-direction-walk'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+
+async function openControl(page, sel) {
+  let c = page.locator(sel);
+  if (!(await c.count())) c = page.locator(sel.replace('#extra-controls ', '#extra-visual '));
+  assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value));
+      else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' +
+        Object.entries(s.data || {}).map(([key,value]) => '[data-' + key + '="' + value + '"]').join('');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P115W_SOURCES, replayP115WDirectionWalkEvidence, submittedP115WDirectionWalkEvidence} = await entry('dist/learning/p115w-direction-walk-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b24 = await entry('dist/learning/phase5/b24-model.js');
+
+const wrongSteps = task => b24.solveSteps(task).map(step =>
+  step.field === 'answers.0' ? {...step, value: task.questions[0].options?.find(([id]) => id !== step.value)?.[0] ?? '0'} : step);
+const correctSteps = task => b24.solveSteps(task).filter(step => step.field);
+
+  const cases = P115W_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP115WDirectionWalkEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b24.inspect(row.task, r.model).correct, evidence: Boolean(proof(row, r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P115W');
+    let lastSid = null, cur = 0;
+    for (const row of cases) {
+      if (row.id !== lastSid) {
+        if (lastSid) await page.goto(origin.base + 'v2.html#trail');
+        ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, row.id + ' offline');
+        await page.waitForFunction(() => window.mathLesson);
+        const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+        lastSid = row.id; cur = 0;
+      }
+      while (cur < row.index) {
+        const prior=sessionTaskFor(row.id,cur);
+        await runSteps(page,b24.solveSteps(prior));
+        await page.locator('#actions [data-do="check"]').click();
+        await page.locator('#actions [data-do="next"]').click();
+        cur++; await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+      const tag = row.id + '-' + row.index;
+      ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, tag + ' hash');
+      await runSteps(page,wrongSteps(row.task));
+      await page.locator('#actions [data-do="check"]').click();
+      const wrong=await observe(page,row,'wrong-check');
+      ok(wrong.attempts.length===1 && !b24.inspect(row.task,wrong.model).correct && !proof(row,wrong),
+        'the incorrect first step fails the original Check');
+      await picture(page,tag+'-wrong.png');
+      await runSteps(page,correctSteps(row.task));
+      const draft=await observe(page,row,'corrected-draft');
+      const replayed=replayP115WDirectionWalkEvidence(row.task,draft.model,row.context);
+      ok(Boolean(replayed) && !proof(row,draft),'correction awaits a fresh Check');
+      await page.locator('#actions [data-do="check"]').click();
+      const good=await observe(page,row,'correct-check');
+      const accepted=proof(row,good);
+      ok(good.attempts.length===2 && Boolean(accepted),'new Check preserves all steps');
+      await picture(page, tag + '-correct.png');
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      assert.deepEqual(proof(row, await observe(page, row, 'offline-reload')), accepted);
+      verified.push({row, good, accepted});
+      const next = cases[cases.indexOf(row) + 1];
+      if (next && next.id === row.id) {
+        await page.locator('#actions [data-do="next"]').click(); cur++;
+        await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+    }
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p009a.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p115wr.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb,
+      'corrupt import preserves exact bytes');
+    const last = verified.at(-1);
+    await restorePage.goto(origin.base + 'learn.html#' + last.row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    for (const {row, good, accepted} of verified) {
+      const stage = row === last.row ? 'restored-backup' : 'restored-storage';
+      const imported = await observe(restorePage, row, stage);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row, imported), accepted);
+      checks.push(row.index + ' imported history and rechecked proof match');
+    }
+    await page.goto(origin.base + 'learn.html#' + last.row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(last.row, await observe(page, last.row, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P115W_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p115w-direction-walk-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P115W_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p115w-direction-walk.test.mjs b/tests/p9-p115w-direction-walk.test.mjs
