+++ b/tests/p9-p111g-algebra-products.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {example, inspect} from '../dist/learning/phase5/b35-model.js';
+import {P111G_SOURCES, replayP111GAlgebraProductsEvidence, submittedP111GAlgebraProductsEvidence} from '../dist/learning/p111g-algebra-products-evidence.js';
+
+const ordered = value => Array.isArray(value) ? value.map(ordered) :
+  value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])) : value;
+
+for (const {sessionId, index, taskHash} of P111G_SOURCES) {
+  test(`${sessionId}:${index} replays all product cells and total polynomial`, () => {
+    const context = {sessionId, index};
+    const task = sessionTaskFor(sessionId, index);
+    const replay = model => replayP111GAlgebraProductsEvidence(task, model, context);
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), taskHash);
+    const correct = example(task);
+    assert.ok(inspect(task, correct).correct);
+    assert.deepEqual(replay(correct)?.cells.length, task.rows.length*task.cols.length);
+    assert.equal(replayP111GAlgebraProductsEvidence(task, correct, {sessionId, index:-1}), null);
+    const wrong = structuredClone(correct);
+    wrong.answers[0] = '999';
+    assert.equal(replay(wrong), null);
+    assert.equal(submittedP111GAlgebraProductsEvidence(task, correct, {attempts:[{value:wrong}]}, context), null);
+    assert.deepEqual(submittedP111GAlgebraProductsEvidence(task, correct, {attempts:[{value:structuredClone(correct)}]}, context), replay(correct));
+    const forged = structuredClone(correct);
+    forged.history[0].v = '27';
+    assert.equal(replay(forged), null);
+    const tampered=structuredClone(correct);
+    tampered.board.cells[0]='999';
+    assert.equal(replay(tampered),null);
+  });
+}
