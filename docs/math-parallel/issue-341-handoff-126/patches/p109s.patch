--- /dev/null
+++ b/tests/p9-p109s-formula-substitution.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {act, example, inspect} from '../dist/learning/phase5/b36-model.js';
+import {P109S_SOURCES, replayP109SFormulaSubstitutionEvidence, submittedP109SFormulaSubstitutionEvidence} from '../dist/learning/p109s-formula-substitution-evidence.js';
+
+const ordered = value => Array.isArray(value) ? value.map(ordered) :
+  value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])) : value;
+
+for (const {sessionId, index, taskHash} of P109S_SOURCES) {
+  test(`${sessionId}:${index} replays exact substitution for each required case`, () => {
+    const context = {sessionId, index};
+    const task = sessionTaskFor(sessionId, index);
+    const replay = model => replayP109SFormulaSubstitutionEvidence(task, model, context);
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), taskHash);
+    const correct = example(task);
+    assert.ok(inspect(task, correct).correct);
+    assert.deepEqual(replay(correct)?.cases, task.required);
+    assert.equal(replayP109SFormulaSubstitutionEvidence(task, correct, {sessionId, index:-1}), null);
+    const wrong = structuredClone(correct);
+    wrong.value = '999';
+    assert.equal(replay(wrong), null);
+    assert.equal(submittedP109SFormulaSubstitutionEvidence(task, correct, {attempts:[{value:wrong}]}, context), null);
+    assert.deepEqual(submittedP109SFormulaSubstitutionEvidence(task, correct, {attempts:[{value:structuredClone(correct)}]}, context), replay(correct));
+    const forged = structuredClone(correct);
+    forged.history.find(event => event.a === 'trial').v = '27';
+    assert.equal(replay(forged), null);
+    correct.value = '999';
+    act(task, correct, 'f36-trial');
+    assert.equal(replay(correct), null);
+  });
+}
