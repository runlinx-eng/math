index 0000000000000000000000000000000000000000..9d1b134f94d95ee4917a5199bd8411a3df5e1af0
--- /dev/null
+++ b/dist/learning/p094d-decimal-products-evidence.js
@@ -0,0 +1,133 @@
+import {number} from './phase5/b14-model.js';
+import {initial, inspect, valid} from './phase5/b15-model.js';
+import {equal} from './phase5/b16-model.js';
+import {
+  hasExactKeys,
+  latestSubmissionMatches,
+  matchesNativeEvidenceTask,
+  sameEvidence
+} from './evidence-contract.js';
+
+const kind = 'p094d-decimal-products';
+export const P094D_SOURCES = Object.freeze([
+  {
+    "sessionId": "mentalchoices",
+    "index": 2,
+    "nodeId": "mt_vmW2cb5c7A",
+    "type": "x-decimalproduct",
+    "taskHash": "1d739fd4e69645b4e6b7e12176e6a051fbc772dc6f1520b02ac02309982e38f6"
+  },
+  {
+    "sessionId": "fractionfour",
+    "index": 15,
+    "nodeId": "mt_gNUE4B3vuk",
+    "type": "x-decimalproduct",
+    "taskHash": "c5145e209159f21c69f6eeb00367fe4f7122049e5d57a0c0aff1dcb2581beadf"
+  }
+].map(Object.freeze));
+
+export function p094dDecimalProductsBinding(task,context) {
+  const row=P094D_SOURCES.find(source=>source.sessionId===context?.sessionId&&source.index===context?.index);
+  if (!row||!matchesNativeEvidenceTask(task,context,row)) return null;
+  return {nodeId:row.nodeId,kind,method:null,question:'积里有多少个原来的小单位？多少份这样的小单位合成 1？'};
+}
+
+// The single-row remainder follows the same replay as the first P094 family.
+const fresh = () => ({estimated:false,carry:0,pending:null,columns:[],row:null});
+
+export function replayP094DDecimalProductsEvidence(task,model,context) {
+  try {
+    const binding = p094dDecimalProductsBinding(task,context);
+    const blank = binding && initial(task);
+    if (!binding || !hasExactKeys(model,Object.keys(blank)) ||
+        !hasExactKeys(model.inner,Object.keys(blank.inner)) || !valid(task,model) ||
+        model.issue !== '' || model.inner.issue !== '' || !model.inner.history.length ||
+        Object.keys(model.inner.history).length !== model.inner.history.length ||
+        Object.keys(model.history).length !== model.history.length ||
+        !model.history.every(event => event.action === 'b15-reset' &&
+          event.data.index === null && event.data.value === null)) return null;
+
+    const [whole,fraction] = task.decimal.split('.');
+    const unitsPerWhole = 10**fraction.length;
+    const amount = Number(whole)*unitsPerWhole + Number(fraction);
+    const product = amount*task.multiplier;
+    const digits = [...String(amount)].reverse().map(Number);
+    const actions = [];
+    let state = fresh(), resets = 0;
+
+    for (const [index,event] of model.inner.history.entries()) {
+      const {action,data} = event;
+      const f = data.fields;
+      if (data.index !== null || data.side !== null || data.value !== null) return null;
+      if (action === 'b14-reset') {
+        resets++;
+        state = fresh();
+        actions.push({index,action});
+        continue;
+      }
+      if (action === 'b14-estimate') {
+        if (state.estimated) return null;
+        state.estimated = number(f.estimate) === task.estimate*task.multiplier;
+        actions.push({index,action,raw:f.estimate,accepted:state.estimated});
+        continue;
+      }
+      if (!state.estimated || state.row) return null;
+      const col = state.columns.length;
+      if (action === 'b14-mul-count' && !state.pending && col < digits.length) {
+        const raw = digits[col]*task.multiplier + state.carry;
+        const accepted = number(f.raw) === raw;
+        if (accepted) state.pending = {raw,loose:raw,bundles:0};
+        actions.push({index,action,col,raw:f.raw,accepted});
+        continue;
+      }
+      if (action === 'b14-trade' && state.pending && state.pending.loose >= 10) {
+        state.pending.loose -= 10;
+        state.pending.bundles++;
+        actions.push({index,action,col,remaining:state.pending.loose,carried:state.pending.bundles});
+        continue;
+      }
+      if (action === 'b14-digit' && state.pending) {
+        const {raw,loose,bundles} = state.pending;
+        const accepted = loose < 10 && number(f.digit) === loose;
+        if (accepted) {
+          if (raw !== loose + bundles*10) return null;
+          state.columns.push({row:0,col,raw,loose,bundles,incoming:state.carry});
+          state.carry = bundles;
+          state.pending = null;
+        }
+        actions.push({index,action,col,raw:f.digit,accepted});
+        continue;
+      }
+      if (action !== 'b14-row' || state.pending || col !== digits.length) return null;
+      const accepted = number(f.shift) === 0 && number(f.rowvalue) === product;
+      if (accepted) {
+        const rowDigits = state.columns.map(column => column.loose);
+        const composed = rowDigits.reduce((value,digit,place) => value+digit*10**place,0) +
+          state.carry*10**rowDigits.length;
+        if (composed !== product) return null;
+        state.row = {value:product,shift:0,digits:rowDigits,carry:state.carry};
+      }
+      actions.push({index,action,shift:f.shift,raw:f.rowvalue,accepted});
+    }
+
+    const recorded = model.inner.board;
+    if (!state.row || resets !== model.history.length || !sameEvidence(state.columns,recorded.work) ||
+        !sameEvidence([state.row],recorded.rows) || number(model.inner.answer) !== product ||
+        !equal(model.unit,unitsPerWhole) || !equal(model.answer,product,unitsPerWhole) ||
+        !inspect(task,model).correct) return null;
+
+    return {
+      ...binding,sessionId:context.sessionId,index:context.index,
+      operandInSmallUnits:amount,multiplier:task.multiplier,productInSmallUnits:product,unitsPerWhole,
+      result:{numerator:product,denominator:unitsPerWhole},
+      columns:state.columns,actions,resets,learnerMasteryAssessed:false
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP094DDecimalProductsEvidence(task,model,record,context) {
+  if (!latestSubmissionMatches(model,record)) return null;
+  return replayP094DDecimalProductsEvidence(task,model,context);
+}
diff --git a/tests/p9-p094d-decimal-products-browser.cjs b/tests/p9-p094d-decimal-products-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..b2c6c34e645b5edef651c7d902f7cf687f93e6a2
--- /dev/null
+++ b/tests/p9-p094d-decimal-products-browser.cjs
@@ -0,0 +1,180 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P094D_ARTIFACTS || path.join(root, 'verification/p9-p094d-decimal-products'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+
+async function openControl(page, sel) {
+  let c = page.locator(sel);
+  if (!(await c.count())) c = page.locator(sel.replace('#extra-controls ', '#extra-visual '));
+  if (!(await c.count())) c = page.locator(sel.replace('#extra-controls ', ''));
+  assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value));
+      else if (await inp.getAttribute('type')==='range') {
+        const desired=Number(s.value);
+        const initial=Number(await inp.inputValue());
+        for (let i=0;i<Math.abs(initial-desired);i++) await inp.press(initial<desired?'ArrowRight':'ArrowLeft');
+      } else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' +
+        Object.entries(s.data || {}).map(([key,value]) => '[data-' + key + '="' + value + '"]').join('');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P094D_SOURCES, replayP094DDecimalProductsEvidence, submittedP094DDecimalProductsEvidence} = await entry('dist/learning/p094d-decimal-products-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b15 = await entry('dist/learning/phase5/b15-model.js');
+  const b09 = await entry('dist/learning/phase5/b09-model.js');
+  const b11 = await entry('dist/learning/phase5/b11-model.js');
+  const b14 = await entry('dist/learning/phase5/b14-model.js');
+  const b17 = await entry('dist/learning/phase5/b17-model.js');
+
+function prerequisiteSteps(task,b09,models) {
+  if (task.type!=='x-directedjump') return models.find(model=>model.TYPES.has(task.type)).solveSteps(task);
+  const sample=b09.example(task);
+  const field=(field,value)=>({field,value:String(value)});
+  const steps=[field('anchor',sample.anchor),field('guess',sample.guess),{action:'direct-predict'}];
+  if (task.reverse) steps.push(field('reference',sample.reference),{action:'direct-reference'});
+  for (const n of sample.jumps) steps.push(field('size',Math.abs(n)),field('dir',n>0?'right':'left'),{action:'direct-jump'});
+  steps.push(field('answer',sample.answer));
+  if (task.zero) steps.push(field('zero',sample.zero));
+  return steps;
+}
+const wrongSteps = task => b15.solveSteps(task).map(step => step.field==='answer' ? {...step,value:'999'} : step);
+const correctSteps = task => b15.solveSteps(task).filter(step => step.field==='answer');
+  const cases = P094D_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP094DDecimalProductsEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b15.inspect(row.task, r.model).correct, evidence: Boolean(proof(row, r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P094D');
+    let lastSid = null, cur = 0;
+    for (const row of cases) {
+      if (row.id !== lastSid) {
+        if (lastSid) await page.goto(origin.base + 'v2.html#trail');
+        ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, row.id + ' offline');
+        await page.waitForFunction(() => window.mathLesson);
+        const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+        lastSid = row.id; cur = 0;
+      }
+      while (cur < row.index) {
+        const prior=sessionTaskFor(row.id,cur);
+        await runSteps(page,prerequisiteSteps(prior,b09,[b11,b14,b15,b17]));
+        await page.locator('#actions [data-do="check"]').click();
+        await page.locator('#actions [data-do="next"]').click();
+        cur++; await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+      const tag = row.id + '-' + row.index;
+      ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, tag + ' hash');
+      await runSteps(page,wrongSteps(row.task));
+      await page.locator('#actions [data-do="check"]').click();
+      const wrong=await observe(page,row,'wrong-check');
+      ok(wrong.attempts.length===1 && !b15.inspect(row.task,wrong.model).correct && !proof(row,wrong),
+        'the incorrect first step fails the original Check');
+      await picture(page,tag+'-wrong.png');
+      await runSteps(page,correctSteps(row.task));
+      const draft=await observe(page,row,'corrected-draft');
+      const replayed=replayP094DDecimalProductsEvidence(row.task,draft.model,row.context);
+      ok(Boolean(replayed) && !proof(row,draft),'correction awaits a fresh Check');
+      await page.locator('#actions [data-do="check"]').click();
+      const good=await observe(page,row,'correct-check');
+      const accepted=proof(row,good);
+      ok(good.attempts.length===2 && Boolean(accepted),'new Check preserves all steps');
+      await picture(page, tag + '-correct.png');
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      assert.deepEqual(proof(row, await observe(page, row, 'offline-reload')), accepted);
+      verified.push({row, good, accepted});
+      const next = cases[cases.indexOf(row) + 1];
+      if (next && next.id === row.id) {
+        await page.locator('#actions [data-do="next"]').click(); cur++;
+        await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+    }
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p009a.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p098qr.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb,
+      'corrupt import preserves exact bytes');
+    const last = verified.at(-1);
+    await restorePage.goto(origin.base + 'learn.html#' + last.row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    for (const {row, good, accepted} of verified) {
+      const stage = row === last.row ? 'restored-backup' : 'restored-storage';
+      const imported = await observe(restorePage, row, stage);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row, imported), accepted);
+      checks.push(row.index + ' imported history and rechecked proof match');
+    }
+    await page.goto(origin.base + 'learn.html#' + last.row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(last.row, await observe(page, last.row, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P094D_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p094d-decimal-products-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P094D_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p094d-decimal-products.test.mjs b/tests/p9-p094d-decimal-products.test.mjs
