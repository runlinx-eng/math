index 0000000000000000000000000000000000000000..a7521325ef05be75d8340f875eb57abe9963b617
--- /dev/null
+++ b/dist/learning/p103t-program-trace-evidence.js
@@ -0,0 +1,173 @@
+import {initial,valid} from './phase5/b34-model.js';
+import {rational} from './phase5/b16-model.js';
+import {hasExactKeys,latestSubmissionMatches,matchesNativeEvidenceTask,sameEvidence} from './evidence-contract.js';
+
+export const P103T_SOURCES=Object.freeze([
+  {
+    "sessionId": "trace34",
+    "index": 0,
+    "nodeId": "mt_zQfWqImxva",
+    "type": "x-p34-program",
+    "taskHash": "0dc393d18025bc6b94aa12ccf20c6641a404506f792377b8d0a4b2bb550cd136"
+  },
+  {
+    "sessionId": "trace34",
+    "index": 1,
+    "nodeId": "mt_zQfWqImxva",
+    "type": "x-p34-program",
+    "taskHash": "174fc76cca3b87849dd95c0cd6ca427401c42106d9f731beb643fe5e9be9a7d9"
+  },
+  {
+    "sessionId": "trace34",
+    "index": 2,
+    "nodeId": "mt_zQfWqImxva",
+    "type": "x-p34-program",
+    "taskHash": "3e76d246e5e966c5a55cae2327b0df6a9f886df2c9bab9a3d134866d889d7ce1"
+  },
+  {
+    "sessionId": "generate34",
+    "index": 0,
+    "nodeId": "mt_QeKWt4BZn3",
+    "type": "x-p34-program",
+    "taskHash": "f089f2b20b5e4067ab79da7f1ed61acef080127c9c6c564c38022d7f8536f92a"
+  },
+  {
+    "sessionId": "generate34",
+    "index": 1,
+    "nodeId": "mt_QeKWt4BZn3",
+    "type": "x-p34-program",
+    "taskHash": "6fee96e3bae0412e7fbde8a9e0d3816af0b96630a245f6d2fe2ffdae39b6d0b6"
+  },
+  {
+    "sessionId": "design34",
+    "index": 0,
+    "nodeId": "mt_nx4a3kH-59",
+    "type": "x-p34-program",
+    "taskHash": "3cbd5146577df2cb9b773c430ca53039a285bd431b1ea77faf7b0ec77b397c8c"
+  },
+  {
+    "sessionId": "design34",
+    "index": 1,
+    "nodeId": "mt_nx4a3kH-59",
+    "type": "x-p34-program",
+    "taskHash": "e30f6370df100ab654f2776554a988537838729d67e5304050b82d488318d4fe"
+  }
+].map(Object.freeze));
+
+const bucket=n=>n%15===0?'both':n%3===0?'three':n%5===0?'five':'neither';
+
+function run(mode,blocks) {
+  if (mode==='classify'&&blocks.length===4) {
+    const output=Array.from({length:30},(_,i)=>{
+      const n=i+1;
+      const matches={both:n%15===0,three:n%3===0,five:n%5===0,neither:true};
+      return {n,group:blocks.find(b=>matches[b])};
+    });
+    return {output,correct:output.every(({n,group})=>group===bucket(n))};
+  }
+  if (mode==='loop'&&blocks.length===3&&blocks[0]==='repeat') {
+    const output=[1];
+    for (let i=0;i<10;i++) {
+      output.push(blocks.slice(1).reduce((n,b)=>b==='double'?2*n:n+1,output.at(-1)));
+    }
+    return {output,correct:output.every((n,i)=>n===2**(i+1)-1)};
+  }
+  return null;
+}
+
+function answers(mode,board) {
+  const last=board.values.at(-1);
+  if (mode==='walk') return [board.values.length-1,last];
+  if (mode==='threshold') return [50,80].map(n=>board.records.find(row=>row.n===n)?.out);
+  if (mode==='sort10') return ['low','high'].map(c=>board.records.filter(row=>row.choice===c).length);
+  if (mode==='double') return [last];
+  if (mode==='add7') return [last,board.values.includes(84)?'yes':'no'];
+  const result=run(mode,board.blocks);
+  if (!result?.correct) return [];
+  if (mode==='classify') return [result.output.filter(x=>x.group==='both').length,result.output[14].group];
+  return [result.output.at(-1),result.output.every(n=>n%2===1)?'odd':'even'];
+}
+
+export function p103tProgramTraceBinding(task,context) {
+  const row=P103T_SOURCES.find(s=>s.sessionId===context?.sessionId&&s.index===context?.index);
+  if (!row||!matchesNativeEvidenceTask(task,context,row)) return null;
+  return {nodeId:row.nodeId,kind:'p103t-program-trace',method:null,
+    question:'每一步用哪条条件决定？到了哪里才应该停止？'};
+}
+
+export function replayP103TProgramTraceEvidence(task,model,context) {
+  try {
+    const binding=p103tProgramTraceBinding(task,context);
+    if (!binding||!hasExactKeys(model,Object.keys(initial(task)))||!valid(task,model)||
+        model.issue!==''||Object.keys(model.history).length!==model.history.length) return null;
+    const {mode}=task;
+    const {board}=initial(task);
+    const repeat=['double','add7'].includes(mode), design=['classify','loop'].includes(mode);
+    const canContinue=n=>mode==='double'?n<=100:n+7<80;
+    let rejected=false;
+    for (const e of model.history) {
+      if (!hasExactKeys(e,['a','i','v','w'])||e.v||e.w) return null;
+      rejected=false;
+      const {a,i}=e, n=board.values.at(-1);
+      if (mode==='walk'&&a==='step'&&!board.done&&['half','plus'].includes(i)) {
+        const choice=n%2===0?'half':'plus';
+        board.first.step??=i;
+        rejected=i!==choice;
+        if (!rejected) {
+          const next=choice==='half'?n/2:n+1;
+          board.values.push(next);
+          board.done=next===1;
+        }
+      } else if ((mode==='threshold'||mode==='sort10')&&a==='branch'&&!board.done) {
+        const threshold=mode==='threshold', input=task.inputs[board.records.length];
+        if (!(threshold?['yes','no']:['low','high']).includes(i)) return null;
+        const choice=threshold?(input>50?'yes':'no'):(input<10?'low':'high');
+        board.first.branch??={n:input,choice:i};
+        rejected=i!==choice;
+        if (!rejected) {
+          board.records.push({n:input,choice,out:threshold?input+(input>50?-10:10):choice});
+          board.done=board.records.length===task.inputs.length;
+        }
+      } else if (repeat&&(a==='step'||a==='stop')&&!i&&!board.done) {
+        if (a==='step') {
+          rejected=!canContinue(n);
+          if (!rejected) board.values.push(mode==='double'?n*2:n+7);
+        } else {
+          board.first.stop??=n;
+          rejected=canContinue(n);
+          board.done=!rejected;
+        }
+      } else if (design&&a==='block'&&!board.blocks.includes(i)&&task.blocks.some(block=>block.id===i)) {
+        board.blocks.push(i);
+        board.done=false;
+      } else if (design&&!i&&['undo','clear','run'].includes(a)) {
+        if (a==='clear') board.blocks=[];
+        if (a==='undo') board.blocks.pop();
+        board.done=false;
+        if (a==='run') {
+          const result=run(mode,board.blocks);
+          board.first.blocks??=[...board.blocks];
+          rejected=!result?.correct;
+          if (result&&board.runs.length<30) board.runs.push({blocks:[...board.blocks],...result});
+          board.done=!rejected;
+        }
+      } else return null;
+      if (rejected) board.bad=true;
+    }
+    if (rejected||!board.done||!sameEvidence(board,model.board)) return null;
+    const conclusions=answers(mode,board);
+    if (conclusions.length!==task.questions.length||!conclusions.every((answer,i)=>{
+      const raw=model.answers[i].trim();
+      if (typeof answer==='string') return raw===answer;
+      const pair=rational(raw);
+      return pair!==null&&BigInt(pair[0])===BigInt(answer)*BigInt(pair[1]);
+    })) return null;
+    return {...binding,mode,conclusions,values:board.values,records:board.records,run:design?run(mode,board.blocks):null};
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP103TProgramTraceEvidence(task,model,record,context) {
+  return latestSubmissionMatches(model,record)?replayP103TProgramTraceEvidence(task,model,context):null;
+}
diff --git a/tests/p9-p103t-program-trace-browser.cjs b/tests/p9-p103t-program-trace-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..baad51d8a8861263054e27bea2d1da44e0c61d0e
--- /dev/null
+++ b/tests/p9-p103t-program-trace-browser.cjs
@@ -0,0 +1,164 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P103T_ARTIFACTS || path.join(root, 'verification/p9-p103t-program-trace'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+
+async function openControl(page, sel) {
+  let c = page.locator(sel);
+  if (!(await c.count())) c = page.locator(sel.replace('#extra-controls ', '#extra-visual '));
+  assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value));
+      else if (await inp.getAttribute('type')==='range') {
+        const value=Number(await inp.inputValue());
+        const step=Number(await inp.getAttribute('step'));
+        const target=Number(s.value);
+        for (let i=0;i<Math.round(Math.abs(value-target)/step);i++) await inp.press(value<target?'ArrowRight':'ArrowLeft');
+      } else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' +
+        Object.entries(s.data || {}).map(([key,value]) => '[data-' + key + '="' + value + '"]').join('');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P103T_SOURCES, replayP103TProgramTraceEvidence, submittedP103TProgramTraceEvidence} = await entry('dist/learning/p103t-program-trace-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b34 = await entry('dist/learning/phase5/b34-model.js');
+  const wrongSteps = task => b34.solveSteps(task).slice(0,-1);
+  const correctSteps = task => b34.solveSteps(task).slice(-1);
+  const cases = P103T_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP103TProgramTraceEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b34.inspect(row.task, r.model).correct, evidence: Boolean(proof(row, r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P103T');
+    let lastSid = null, cur = 0;
+    for (const row of cases) {
+      if (row.id !== lastSid) {
+        if (lastSid) await page.goto(origin.base + 'v2.html#trail');
+        ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, row.id + ' offline');
+        await page.waitForFunction(() => window.mathLesson);
+        const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+        lastSid = row.id; cur = 0;
+      }
+      while (cur < row.index) {
+        const prior=sessionTaskFor(row.id,cur);
+        await runSteps(page,b34.solveSteps(prior));
+        await page.locator('#actions [data-do="check"]').click();
+        await page.locator('#actions [data-do="next"]').click();
+        cur++; await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+      const tag = row.id + '-' + row.index;
+      ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, tag + ' hash');
+      await runSteps(page,wrongSteps(row.task));
+      await page.locator('#actions [data-do="check"]').click();
+      const wrong=await observe(page,row,'wrong-check');
+      ok(wrong.attempts.length===1 && !b34.inspect(row.task,wrong.model).correct && !proof(row,wrong),
+        'a missing program conclusion fails the original Check');
+      await picture(page,tag+'-wrong.png');
+      await runSteps(page,correctSteps(row.task));
+      const draft=await observe(page,row,'corrected-draft');
+      const replayed=replayP103TProgramTraceEvidence(row.task,draft.model,row.context);
+      ok(Boolean(replayed) && !proof(row,draft),'correction awaits a fresh Check');
+      await page.locator('#actions [data-do="check"]').click();
+      const good=await observe(page,row,'correct-check');
+      const accepted=proof(row,good);
+      ok(good.attempts.length===2 && Boolean(accepted),'new Check preserves all steps');
+      await picture(page, tag + '-correct.png');
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      assert.deepEqual(proof(row, await observe(page, row, 'offline-reload')), accepted);
+      verified.push({row, good, accepted});
+      const next = cases[cases.indexOf(row) + 1];
+      if (next && next.id === row.id) {
+        await page.locator('#actions [data-do="next"]').click(); cur++;
+        await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+    }
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p103t.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p103t-repeat.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb,
+      'corrupt import preserves exact bytes');
+    const last = verified.at(-1);
+    await restorePage.goto(origin.base + 'learn.html#' + last.row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    for (const {row, good, accepted} of verified) {
+      const stage = row === last.row ? 'restored-backup' : 'restored-storage';
+      const imported = await observe(restorePage, row, stage);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row, imported), accepted);
+      checks.push(row.index + ' imported history and rechecked proof match');
+    }
+    await page.goto(origin.base + 'learn.html#' + last.row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(last.row, await observe(page, last.row, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P103T_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p103t-program-trace-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P103T_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p103t-program-trace.test.mjs b/tests/p9-p103t-program-trace.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7fd531e67319aba770f215853a4be0441c2dbd7c
--- /dev/null
+++ b/tests/p9-p103t-program-trace.test.mjs
@@ -0,0 +1,49 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {act,example,initial,inspect,solveSteps} from '../dist/learning/phase5/b34-model.js';
+import {P103T_SOURCES,replayP103TProgramTraceEvidence,submittedP103TProgramTraceEvidence} from '../dist/learning/p103t-program-trace-evidence.js';
+
+const ordered=value=>Array.isArray(value)?value.map(ordered):
+  value&&typeof value==='object'?Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])):value;
+
+for (const {sessionId,index,taskHash} of P103T_SOURCES) {
+  test(`${sessionId}:${index} recomputes condition branches, the stop point and block output`,()=>{
+    const task=sessionTaskFor(sessionId,index);
+    const context={sessionId,index};
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'),taskHash);
+    const good=example(task);
+    assert.ok(inspect(task,good).correct);
+    const replay=model=>replayP103TProgramTraceEvidence(task,model,context);
+    const proof=replay(good);
+    assert.deepEqual(proof?.conclusions,task.questions.map(q=>q.value));
+    if (task.mode==='classify'||task.mode==='loop') {
+      const retry=initial(task);
+      const ids=task.blocks.map(block=>block.id).reverse();
+      for (const index of ids) act(task,retry,'p34-block',{index});
+      act(task,retry,'p34-run');
+      assert.equal(replay(retry),null);
+      act(task,retry,'p34-clear');
+      for (const step of solveSteps(task)) {
+        if (step.action) act(task,retry,step.action,step.data);
+        else retry.answers[Number(step.field.split('.')[1])]=step.value;
+      }
+      assert.deepEqual(replay(retry),proof);
+    }
+    assert.equal(replayP103TProgramTraceEvidence(task,good,{sessionId,index:-1}),null);
+    for (const change of [
+      m=>{m.history=[];},
+      m=>{m.history[0].i='impossible';},
+      m=>{m.history[0].v='tampered';},
+      m=>{m.board.done=false;},
+      m=>{m.answers[0]='arbitrary';},
+    ]) {
+      const bad=structuredClone(good);
+      change(bad);
+      assert.equal(replay(bad),null);
+      assert.equal(submittedP103TProgramTraceEvidence(task,good,{attempts:[{value:bad}]},context),null);
+    }
+    assert.deepEqual(submittedP103TProgramTraceEvidence(task,good,{attempts:[{value:structuredClone(good)}]},context),proof);
+  });
+}
