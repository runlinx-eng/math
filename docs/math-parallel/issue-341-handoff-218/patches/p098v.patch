index 0000000000000000000000000000000000000000..c5f33ddae361fa5c5519fe8fd30516e75172bafa
--- /dev/null
+++ b/tests/p9-p098v-coefficient-views.test.mjs
@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {example,inspect} from '../dist/learning/phase5/b36-model.js';
+import {P098V_SOURCES, replayP098VCoefficientViewsEvidence, submittedP098VCoefficientViewsEvidence} from '../dist/learning/p098v-coefficient-views-evidence.js';
+
+const ordered=value=>Array.isArray(value)?value.map(ordered):
+  value&&typeof value==='object'?Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])):value;
+
+for (const {sessionId,index,taskHash} of P098V_SOURCES) {
+  test(`${sessionId}:${index} checks the saved construction and the submitted conclusion`,()=>{
+    const task=sessionTaskFor(sessionId,index);
+    const context={sessionId,index};
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'),taskHash);
+    const good=example(task);
+    assert.ok(inspect(task,good).correct);
+    const replay=model=>replayP098VCoefficientViewsEvidence(task,model,context);
+    const proof=replay(good);
+    assert.ok(proof);
+    assert.equal(replayP098VCoefficientViewsEvidence(task,good,{sessionId,index:-1}),null);
+    for (const edit of [
+      m=>{m.history=[];},
+      m=>{m.history[0].a='select';},
+      m=>{m.history[0].i='forged';},
+      m=>{m.board.bad=!m.board.bad;},
+      m=>{m.answers.push('forged');},
+    ]) {
+      const bad=structuredClone(good);
+      edit(bad);
+      assert.equal(replay(bad),null);
+      assert.equal(submittedP098VCoefficientViewsEvidence(task,good,{attempts:[{value:bad}]},context),null);
+    }
+    assert.deepEqual(submittedP098VCoefficientViewsEvidence(task,good,{attempts:[{value:structuredClone(good)}]},context),proof);
+  });
+}
