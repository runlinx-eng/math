+++ b/tests/p9-p101s-rotation-symmetry.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {example, inspect} from '../dist/learning/phase5/b24-model.js';
+import {P101S_SOURCES, replayP101SRotationSymmetryEvidence, submittedP101SRotationSymmetryEvidence} from '../dist/learning/p101s-rotation-symmetry-evidence.js';
+
+const ordered = value => Array.isArray(value) ? value.map(ordered) :
+  value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])) : value;
+
+for (const {sessionId, index, taskHash} of P101S_SOURCES) {
+  test(`${sessionId}:${index} replays actual turns, classification or blade placement`, () => {
+    const context = {sessionId, index};
+    const task = sessionTaskFor(sessionId, index);
+    const replay = model => replayP101SRotationSymmetryEvidence(task, model, context);
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), taskHash);
+    const correct = example(task);
+    assert.ok(inspect(task, correct).correct);
+    assert.deepEqual(replay(correct)?.mode, task.mode);
+    assert.equal(replayP101SRotationSymmetryEvidence(task, correct, {sessionId, index:-1}), null);
+    const wrong = structuredClone(correct);
+    wrong.answers[0] = '999';
+    assert.equal(replay(wrong), null);
+    assert.equal(submittedP101SRotationSymmetryEvidence(task, correct, {attempts:[{value:wrong}]}, context), null);
+    assert.deepEqual(submittedP101SRotationSymmetryEvidence(task, correct, {attempts:[{value:structuredClone(correct)}]}, context), replay(correct));
+    const forged = structuredClone(correct);
+    forged.history[0].a = 'reset';
+    assert.equal(replay(forged), null);
+    const tampered=structuredClone(correct);
+    tampered.board.first.spin={unexpected:true};
+    assert.equal(replay(tampered),null);
+  });
+}
