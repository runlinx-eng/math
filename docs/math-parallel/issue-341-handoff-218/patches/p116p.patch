--- /dev/null
+++ b/tests/p9-p116p-pie-sectors.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {example, inspect} from '../dist/learning/phase5/b20-model.js';
+import {P116P_SOURCES, replayP116PPieSectorsEvidence, submittedP116PPieSectorsEvidence} from '../dist/learning/p116p-pie-sectors-evidence.js';
+
+const ordered = value => Array.isArray(value) ? value.map(ordered) :
+  value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en')).map(key=>[key,ordered(value[key])])) : value;
+
+for (const {sessionId, index, taskHash} of P116P_SOURCES) {
+  test(`${sessionId}:${index} replays each sector and confirms 360 degrees and exact ratios`, () => {
+    const context = {sessionId, index};
+    const task = sessionTaskFor(sessionId, index);
+    const replay = model => replayP116PPieSectorsEvidence(task, model, context);
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), taskHash);
+    const correct = example(task);
+    assert.ok(inspect(task, correct).correct);
+    assert.deepEqual(replay(correct)?.angles, task.counts.map(n=>360*n/task.counts.reduce((a,b)=>a+b,0)));
+    assert.equal(replayP116PPieSectorsEvidence(task, correct, {sessionId, index:-1}), null);
+    const wrong = structuredClone(correct);
+    wrong.history=[];
+    assert.equal(replay(wrong), null);
+    assert.equal(submittedP116PPieSectorsEvidence(task, correct, {attempts:[{value:wrong}]}, context), null);
+    assert.deepEqual(submittedP116PPieSectorsEvidence(task, correct, {attempts:[{value:structuredClone(correct)}]}, context), replay(correct));
+    const forged = structuredClone(correct);
+    forged.history[0].f.angle='1';
+    assert.equal(replay(forged), null);
+    const altered=structuredClone(correct);
+    altered.board.angles[0]++;
+    assert.equal(replay(altered),null);
+  });
+}
