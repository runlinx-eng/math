index 0000000000000000000000000000000000000000..360f862e121bf425e73e318d28e3b256f52645bb
--- /dev/null
+++ b/dist/learning/p098-linear-parameter-evidence.js
@@ -0,0 +1,101 @@
+import {equal} from './phase5/b16-model.js';
+import {initial, inspect, valid} from './phase5/b36-model.js';
+import {
+  hasExactKeys,
+  isEvidenceContext,
+  latestSubmissionMatches,
+  matchesNativeEvidenceTask,
+  sameEvidence
+} from './evidence-contract.js';
+
+const sessionId = 'linear36';
+const nodeId = 'mt_WBdHkc2HTf';
+const type = 'x-f36-live';
+const kind = 'p098-linear-parameter';
+const mode = 'linear';
+const originalParameters = {m:1,c:1};
+const reviewed = [
+  {
+    taskHash:'714739071ef5ea036fc663475017f70e0d79c4a353dcd1d1ee34109007878655',
+    task:{
+      type,prompt:'先留下“每步变化＝1”的线，再试2和−1。起点保持不变，比较线的方向。',mode,
+      initial:originalParameters,controls:['m'],required:[{m:1},{m:2},{m:-1}],
+      questions:[{label:'每步变化为负时，从左往右看',value:'down',kind:'choice',options:[['down','线向下'],['up','线向上']]}]
+    }
+  },
+  {
+    taskHash:'7e02231a65ea7ee793066091285a3a107271de2854637340afb9e053f346ab2b',
+    task:{
+      type,prompt:'让每步变化保持1，分别留下起点为1、3和−1的线。线怎样移动？',mode,
+      initial:originalParameters,controls:['c'],required:[{c:1},{c:3},{c:-1}],
+      questions:[{label:'起点是3时，横向为0的位置有多高',value:3,kind:'number'}]
+    }
+  }
+];
+
+export const P098_SOURCES = Object.freeze(reviewed.map(({taskHash},index) =>
+  Object.freeze({sessionId,index,nodeId,type,taskHash})
+));
+
+export function p098LinearParameterBinding(task,context) {
+  if (!isEvidenceContext(context) || context.sessionId !== sessionId ||
+      !sameEvidence(task,reviewed[context.index]?.task) ||
+      !matchesNativeEvidenceTask(task,context,{type,nodeId})) return null;
+  return {nodeId,kind,method:null,question:'哪一个数改变了？每条线在横向为零的位置有多高，右移一步又怎样变化？'};
+}
+
+export function replayP098LinearParameterEvidence(task,model,context) {
+  try {
+    const binding = p098LinearParameterBinding(task,context);
+    if (!binding || !hasExactKeys(model,Object.keys(initial(task))) || !valid(task,model) ||
+        model.issue !== '' || !model.history.length ||
+        Object.keys(model.history).length !== model.history.length) return null;
+
+    const [parameter] = task.controls;
+    let current = task.initial[parameter];
+    const views = new Map(), actions = [];
+    for (const [index,event] of model.history.entries()) {
+      if (!hasExactKeys(event,['a','i','v','w','z']) || event.v !== '' || event.w !== '' || event.z !== '') return null;
+      if (event.a === 'change') {
+        const parts = event.i.split(',');
+        if (parts.length !== 2 || parts[0] !== parameter || !['1','-1'].includes(parts[1])) return null;
+        const before = current;
+        const next = before + Number(parts[1]);
+        if (next >= -3 && next <= 3) current = next;
+        actions.push({index,action:'change',before,after:current});
+        continue;
+      }
+      if (event.a !== 'save' || event.i !== '') return null;
+      const newView = !views.has(current);
+      if (newView) views.set(current,index);
+      actions.push({index,action:'save',value:current,newView});
+    }
+
+    if (!task.required.every(setting => views.has(setting[parameter])) || !views.has(current) ||
+        !sameEvidence([...views.keys()].map(value => ({[parameter]:value})),model.board.views) ||
+        model.board.m !== (parameter === 'm' ? current : task.initial.m) ||
+        model.board.c !== (parameter === 'c' ? current : task.initial.c)) return null;
+
+    const lines = [...views].map(([value,eventIndex]) => {
+      const {m,c} = {...task.initial,[parameter]:value};
+      const atZero = m*0+c, atOne = m+c;
+      return {m,c,atZero,stepChange:atOne-atZero,eventIndex};
+    });
+    const answerMatches = parameter === 'm' ?
+      lines.some(line => line.m === -1 && line.stepChange < 0) && model.answers[0] === 'down' :
+      lines.some(line => line.c === 3 && equal(model.answers[0],line.atZero));
+    if (!answerMatches || !inspect(task,model).correct) return null;
+
+    return {
+      kind,nodeId,sessionId,index:context.index,
+      parameter,current,lines,actions,learnerMasteryAssessed:false
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP098LinearParameterEvidence(task,model,record,context) {
+  if (!latestSubmissionMatches(model,record)) return null;
+  return replayP098LinearParameterEvidence(task,model,context);
+}
diff --git a/tests/p9-p098-linear-parameter-browser.cjs b/tests/p9-p098-linear-parameter-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..d905e8a5c6b9f116fc07f2f0cbd4dcbbf11e989a
--- /dev/null
+++ b/tests/p9-p098-linear-parameter-browser.cjs
@@ -0,0 +1,262 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P098_ARTIFACTS || path.join(root, 'verification/p9-p098-linear-parameter'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd:root, encoding:'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (value, label) => { assert.ok(value, label); checks.push(label); };
+
+function ordered(value) {
+  if (Array.isArray(value)) return value.map(ordered);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en'))
+      .map(key=>[key, ordered(value[key])]));
+  }
+  return value;
+}
+
+async function openControl(page, selector) {
+  const control = page.locator(selector);
+  assert.equal(await control.count(), 1, 'unique original control: ' + selector);
+  for (let i = 0; i < 8 && !(await control.isVisible()); i++) {
+    const closed = control.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await closed.count(), 1);
+    await closed.locator(':scope > summary').click();
+  }
+  return control;
+}
+
+async function routePosition(page, origin, row) {
+  const url = origin.base + 'learn.html#' + row.id;
+  if (row.index === 0) {
+    ok((await page.goto(url))?.fromServiceWorker() === true, 'original first position opens offline');
+    const start = page.locator('[data-do="start"]');
+    if (await start.isVisible()) await start.click();
+  } else {
+    await page.locator('#actions [data-do="next"]').click();
+    checks.push('native Next reaches the second position');
+  }
+  await page.waitForFunction(({id,index}) => {
+    const snap = window.mathLesson?.snapshot();
+    return snap?.id === id && snap.index === index;
+  },row);
+}
+
+async function run() {
+  fs.mkdirSync(out, {recursive:true});
+  const {P098_SOURCES, replayP098LinearParameterEvidence, submittedP098LinearParameterEvidence} =
+    await entry('dist/learning/p098-linear-parameter-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const {inspect} = await entry('dist/learning/phase5/b36-model.js');
+  const expected = [[[1,1],[2,1],[-1,1]],[[1,1],[1,3],[1,-1]]];
+  const cases = P098_SOURCES.map((source, i) => {
+    const {sessionId, index} = source;
+    return {source, id:sessionId, index, context:{sessionId,index},
+      task:sessionTaskFor(sessionId,index), lines:expected[i]};
+  });
+  const verified = [];
+  let origin, browser, learner, restore, page, browserVersion = null, phase = 'startup';
+
+  function proof(row, snap) {
+    return submittedP098LinearParameterEvidence(row.task, snap.model, snap.record, row.context);
+  }
+  async function observe(p, row, stage) {
+    const result = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({
+      index: row.index, stage, attempts: result.attempts.length,
+      parameters: [result.model.board.m,result.model.board.c], views: result.model.board.views, historyLength: result.model.history.length,
+      proof: proof(row, result), storage: result.storage
+    });
+    return result;
+  }
+  async function picture(p, name) {
+    await p.screenshot({path: path.join(out, name)});
+    screenshots.push(name);
+  }
+  async function click(p, selector) {
+    await (await openControl(p, selector)).click();
+  }
+  async function field(p, name, value, select = false) {
+    const loc = await openControl(p, '#extra-controls [data-xfield="' + name + '"]');
+    if (select) await loc.selectOption(String(value));
+    else await loc.fill(String(value));
+    assert.equal(await loc.inputValue(),String(value));
+  }
+
+  try {
+    origin = await createOrigin(root);
+    browser = await chromium.launch({
+      headless: true,
+      args: ['--use-angle=swiftshader','--enable-unsafe-swiftshader'],
+      ...(process.env.MATH_CHROMIUM_EXECUTABLE ? {executablePath:process.env.MATH_CHROMIUM_EXECUTABLE} : {})
+    });
+    browserVersion = browser.version();
+    learner = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow', acceptDownloads:true});
+    restore = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow'});
+    page = await learner.newPage();
+    const restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.setDefaultTimeout(15000);
+      p.on('pageerror', error => errors.push(phase + ': ' + error.message));
+    }
+    for (const context of [learner, restore]) {
+      context.on('request', request => {
+        if (/^https?:/.test(request.url()) && !request.url().startsWith(origin.base)) {
+          errors.push('non-local request: ' + request.url());
+        }
+      });
+    }
+
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P098');
+
+    for (const row of cases) {
+      phase = row.id + ':' + row.index;
+      const tag = row.id + '-' + row.index;
+      await routePosition(page, origin, row);
+      const live = await page.evaluate(async ({id,index}) => {
+        const {sessionTaskFor} = await import('./learning/bridges.js');
+        const {LESSONS} = await import('./learning/catalog.js');
+        return {task:sessionTaskFor(id,index), nodeId:LESSONS[id].topicId};
+      }, row);
+      const digest = createHash('sha256').update(JSON.stringify(ordered(live.task))).digest('hex');
+      ok(live.nodeId === row.source.nodeId && digest === row.source.taskHash, tag + ' source fingerprint');
+      assert.deepEqual(live.task, row.task);
+      ok(await page.evaluate(() => innerWidth === 1920 && innerHeight === 1080), tag + ' standard viewport');
+
+      const [parameter] = row.task.controls;
+      let displayed = row.task.initial[parameter];
+      const moveTo = async target => {
+        while (displayed !== target) {
+          const delta = Math.sign(target-displayed);
+          await click(page,'#extra-controls [data-x="f36-change"][data-index="' + parameter + ',' + delta + '"]');
+          displayed += delta;
+        }
+      };
+      const save = () => click(page,'#extra-controls [data-x="f36-save"]');
+      await save();
+      await save();
+      await moveTo(row.task.required[1][parameter]);
+      await save();
+      const incomplete = await observe(page,row,'two-lines');
+      ok(incomplete.model.board.views.length === 2 &&
+        await page.locator('.f36-saved-line').count() === 2,
+        tag + ' repeated original save does not add another line');
+      const [question] = row.task.questions;
+      await field(page,'answers.0',question.value,Boolean(question.options));
+      await click(page,'#actions [data-do="check"]');
+      const wrong = await observe(page,row,'incomplete-check');
+      ok(wrong.attempts.length === 1 && !inspect(row.task,wrong.attempts[0].value).correct &&
+        !proof(row,wrong),tag + ' correct reading cannot replace a missing saved line');
+      await picture(page,tag + '-incomplete-check.png');
+
+      await moveTo(-1);
+      const unsaved = await observe(page,row,'unsaved-line');
+      ok(unsaved.model.board[parameter] === -1 && unsaved.model.board.views.length === 2 &&
+        !replayP098LinearParameterEvidence(row.task,unsaved.model,row.context),
+        tag + ' changing a parameter does not save the new line');
+      await save();
+      const draft = await observe(page,row,'all-lines');
+      ok(replayP098LinearParameterEvidence(row.task,draft.model,row.context)?.lines.length === 3 &&
+        !proof(row,draft),tag + ' three saved lines require a fresh Check');
+      await click(page,'#actions [data-do="check"]');
+      const good = await observe(page,row,'correct-check');
+      const accepted = proof(row,good);
+      ok(good.attempts.length === 2 && inspect(row.task,good.attempts.at(-1).value).correct &&
+        accepted?.parameter === parameter,tag + ' latest Check verifies the complete comparison');
+      assert.deepEqual(accepted.lines.map(line => [line.stepChange,line.atZero]),row.lines);
+      ok(await page.locator('#thinking-feedback').count() === 0, tag + ' candidate has no global registration');
+      await picture(page, tag + '-correct-check.png');
+
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' stopped-origin reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      const reloaded = await observe(page, row, 'offline-reload');
+      assert.deepEqual(reloaded.model, good.model);
+      assert.deepEqual(reloaded.record, good.record);
+      assert.deepEqual(proof(row,reloaded), accepted);
+      checks.push(tag + ' raw model and both Checks survive reload');
+      verified.push({row, good, accepted});
+    }
+
+    phase = 'State-v2 backup';
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download');
+    await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    const envelope = JSON.parse(bytes);
+    ok(envelope.app === 'math-explorer' && envelope.version === 2, 'real offline State-v2 export');
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+
+    async function upload(buffer, name) {
+      const chooser = restorePage.waitForEvent('filechooser');
+      await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await chooser).setFiles({name, mimeType:'application/json', buffer});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    }
+    ok((await upload(bytes, 'p098-backup.json')).includes('备份已合并'), 'fresh context imports the backup');
+    const restoredBytes = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p098-repeat.json')).includes('备份已合并'), 'repeat import succeeds');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'repeat import preserves exact bytes');
+    ok(!(await upload(Buffer.from('{'), 'p098-corrupt.json')).includes('备份已合并'), 'corrupt backup is rejected');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'failed import preserves exact bytes');
+    await restorePage.goto(origin.base + 'learn.html#' + cases.at(-1).id);
+    await restorePage.waitForFunction(id => window.mathLesson?.snapshot()?.id === id, cases.at(-1).id);
+    for (const {row, good, accepted} of verified) {
+      const imported = await observe(restorePage,row,'restored-backup');
+      assert.deepEqual(imported.model, good.model);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row,imported), accepted);
+      checks.push(row.index + ' restored model, correction and evidence match exactly');
+    }
+
+    phase = 'Retry';
+    const last = verified.at(-1).row;
+    await page.goto(origin.base + 'learn.html#' + last.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.index);
+    await click(page, '[data-do="p3-retry"]');
+    const retry = await observe(page, last, 'retry');
+    ok(retry.model.history.length === 0 && retry.attempts.length === 2 &&
+      proof(last,retry) === null, 'Retry keeps saved attempts and excludes the new blank draft');
+    ok(errors.length === 0, 'no non-local requests or page errors');
+    console.log('P098_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha:sha,chromium:browserVersion,checks:checks.length,captures:observations.length}));
+  } catch (error) {
+    errors.push(phase + ': ' + (error.stack || error));
+    await page?.screenshot({path:path.join(out, 'failure.png')}).catch(() => {});
+    throw error;
+  } finally {
+    fs.writeFileSync(path.join(out,'results.json'),JSON.stringify({
+      schema:'math-p098-linear-parameter-browser/1', testedCheckoutSha:sha,
+      originalControls:true, seededLessonPositionOnly:false, chromium:browserVersion,
+      viewport:STANDARD_DESKTOP_VIEWPORT, sources:P098_SOURCES,
+      checks, observations, screenshots, errors
+    },null,2)+'\n');
+    await restore?.close().catch(() => {});
+    await learner?.close().catch(() => {});
+    await browser?.close().catch(() => {});
+    await origin?.close().catch(() => {});
+  }
+}
+
+run().catch(error => { console.error(error.stack || error); process.exitCode = 1; });
diff --git a/tests/p9-p098-linear-parameter.test.mjs b/tests/p9-p098-linear-parameter.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..39924ada72c4153cd7b00750e042ab73087e4c56
--- /dev/null
+++ b/tests/p9-p098-linear-parameter.test.mjs
@@ -0,0 +1,123 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {BRIDGES, sessionTaskFor} from '../dist/learning/bridges.js';
+import {ensureB39Ready} from '../dist/learning/phase4/async-batches.js';
+import * as original from '../dist/learning/phase5/b36-model.js';
+import {
+  P098_SOURCES,p098LinearParameterBinding,
+  replayP098LinearParameterEvidence,submittedP098LinearParameterEvidence
+} from '../dist/learning/p098-linear-parameter-evidence.js';
+
+const expected = [[[1,1],[2,1],[-1,1]],[[1,1],[1,3],[1,-1]]];
+const rows = P098_SOURCES.map((source,i) => {
+  const {sessionId,index} = source;
+  return {source,context:{sessionId,index},task:sessionTaskFor(sessionId,index),lines:expected[i]};
+});
+
+function ordered(value) {
+  if (Array.isArray(value)) return value.map(ordered);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.keys(value).sort((a,b) => a.localeCompare(b,'en'))
+      .map(key => [key,ordered(value[key])]));
+  }
+  return value;
+}
+
+const act = (row,model,a,i) => original.act(row.task,model,'f36-'+a,i === undefined ? {} : {index:i});
+const replay = (row,model) => replayP098LinearParameterEvidence(row.task,model,row.context);
+const submit = (row,model,...versions) => submittedP098LinearParameterEvidence(row.task,model,
+  {attempts:versions.map(value => ({value:structuredClone(value)}))},row.context);
+
+function save(row,model,target) {
+  const [parameter] = row.task.controls;
+  while (model.board[parameter] !== target) {
+    act(row,model,'change',parameter+','+Math.sign(target-model.board[parameter]));
+  }
+  act(row,model,'save');
+}
+
+function work(row,complete = true) {
+  const model = original.initial(row.task), [parameter] = row.task.controls;
+  save(row,model,1);
+  act(row,model,'save');
+  save(row,model,row.task.required[1][parameter]);
+  if (complete) save(row,model,-1);
+  model.answers = [String(row.task.questions[0].value)];
+  return model;
+}
+
+test('P098 binds the complete originals and preserved source hashes', () => {
+  assert.equal(rows.length,2);
+  for (const {source,task,context} of rows) {
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'),source.taskHash);
+    assert.equal(p098LinearParameterBinding(task,context)?.nodeId,source.nodeId);
+    assert.equal(p098LinearParameterBinding({...task,initial:{m:0,c:1}},context),null);
+    assert.equal(p098LinearParameterBinding({...task,controls:['m','c']},context),null);
+    assert.equal(p098LinearParameterBinding(task,{...context,index:String(context.index)}),null);
+  }
+});
+
+test('P098 derives the exact intercept and per-step change while the other parameter is fixed', () => {
+  for (const row of rows) {
+    const model = work(row), before = structuredClone(model);
+    assert.equal(original.inspect(row.task,model).correct,true);
+    const proof = replay(row,model);
+    assert.deepEqual(proof.lines.map(line => [line.m,line.c]),row.lines);
+    assert.deepEqual(proof.lines.map(line => [line.stepChange,line.atZero]),row.lines);
+    assert.equal(proof.actions.filter(action => action.action === 'save' && !action.newView).length,1);
+    assert.deepEqual(model,before);
+  }
+});
+
+test('P098 requires each saved comparison and latest matching Check', () => {
+  for (const row of rows) {
+    const model = work(row,false), incomplete = structuredClone(model);
+    assert.equal(original.inspect(row.task,model).correct,false);
+    assert.equal(replay(row,model),null);
+    save(row,model,-1);
+    assert.ok(replay(row,model));
+    assert.equal(submit(row,model,incomplete),null);
+    assert.equal(submit(row,model,incomplete,model)?.lines.length,3);
+    assert.equal(submit(row,model,model,incomplete),null);
+  }
+});
+
+test('P098 distinguishes a current draft line from an actual saved line', () => {
+  const row = rows[0], model = work(row);
+  act(row,model,'change','m,1');
+  assert.ok(original.inspect(row.task,model).correct);
+  assert.equal(replay(row,model),null);
+  act(row,model,'save');
+  assert.equal(replay(row,model)?.lines.at(-1).stepChange,0);
+});
+
+test('P098 declines edits to the fixed parameter, forged saves and a wrong reading', () => {
+  const row = rows[1];
+  for (const change of [
+    m => { m.history.length=0; },
+    m => { m.board.views[2].c=1; },
+    m => { m.history[0].i='0'; },
+    m => { m.history[0].v='unverified'; },
