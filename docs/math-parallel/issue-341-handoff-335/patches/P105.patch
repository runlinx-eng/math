new file mode 100644
index 0000000000000000000000000000000000000000..25e8ce29195b0afd78dbe6b6abf4a098f7a358f3
--- /dev/null
+++ b/dist/learning/p105-prime-divisors-evidence.js
@@ -0,0 +1,100 @@
+import {initial, inspect, number, valid} from './phase5/b14-model.js';
+import {
+  hasExactKeys,
+  isEvidenceContext,
+  latestSubmissionMatches,
+  matchesNativeEvidenceTask,
+  sameEvidence
+} from './evidence-contract.js';
+
+const sessionId = 'primetest';
+const nodeId = 'mt_y1XCVsIelg';
+const type = 'x-numbersearch';
+const kind = 'p105-prime-divisors';
+const reviewed = [
+  {
+    taskHash:'0ef3cabc2ab08b88c366890dee7cd0ca50656f97b7b588e16980d0cf305efb01',
+    task:{type,mode:'prime',ns:[1],prompt:'只有1个物品时，有几个不同的因数？它符合“恰好两个”吗？'}
+  },
+  {
+    taskHash:'019704b5ccd5cc445c9ef8c99e3299237c38566ef9047f7b528cf16cad9b1c0f',
+    task:{type,mode:'prime',ns:[2],prompt:'2是偶数。它是不是恰好有两个不同因数？'}
+  },
+  {
+    taskHash:'6c8ce662b07bd596b4cd3507748253afbbdb8077576cfab1320df951597db761',
+    task:{type,mode:'prime',ns:[51],prompt:'51看起来是奇数，能不能排出不止一行的长方形？'}
+  }
+];
+
+export const P105_SOURCES = Object.freeze(reviewed.map(({taskHash},index) =>
+  Object.freeze({sessionId,index,nodeId,type,taskHash})
+));
+
+export function p105PrimeDivisorsBinding(task,context) {
+  if (!isEvidenceContext(context) || context.sessionId !== sessionId ||
+      !sameEvidence(task,reviewed[context.index]?.task) ||
+      !matchesNativeEvidenceTask(task,context,{type,nodeId})) return null;
+  return {nodeId,kind,method:null,question:'哪些试除的余数等于零？算上配对的因数，一共有几个不同因数？'};
+}
+
+const trialInput = ({candidate,remainder}) => ({candidate,remainder});
+
+export function replayP105PrimeDivisorsEvidence(task,model,context) {
+  try {
+    const binding = p105PrimeDivisorsBinding(task,context);
+    if (!binding || !hasExactKeys(model,Object.keys(initial(task))) || !valid(task,model) ||
+        !model.history.length || Object.keys(model.history).length !== model.history.length) return null;
+
+    const [value] = task.ns;
+    const required = [];
+    for (let d=1; d*d<=value; d++) required.push(d);
+    const seen = new Map(), records = [], attempts = [];
+    for (const [index,event] of model.history.entries()) {
+      const data = event.data;
+      if (event.action !== 'b14-test' || data.side !== 0 || data.index !== null || data.value !== null) return null;
+      const raw = trialInput(data.fields);
+      const divisor = number(raw.candidate);
+      const remainder = number(raw.remainder);
+      if (!required.includes(divisor)) {
+        attempts.push({index,raw,accepted:false,reason:'outside-range'});
+        continue;
+      }
+      const expectedRemainder = value % divisor;
+      if (remainder !== expectedRemainder) {
+        attempts.push({index,raw,divisor,expectedRemainder,accepted:false,reason:'wrong-remainder'});
+        continue;
+      }
+      if (seen.has(divisor)) {
+        attempts.push({index,raw,divisor,accepted:false,reason:'duplicate',previous:seen.get(divisor)});
+        continue;
+      }
+      const quotient = Math.floor(value / divisor);
+      if (quotient * divisor + remainder !== value || remainder >= divisor) return null;
+      seen.set(divisor,index);
+      records.push({d:divisor,r:remainder});
+      attempts.push({index,raw,divisor,remainder,quotient,accepted:true});
+    }
+
+    const factors = [...new Set(records.filter(record => record.r === 0)
+      .flatMap(({d}) => [d,value/d]))].sort((a,b) => a-b);
+    const classification = factors.length === 1 ? 'neither' : factors.length === 2 ? 'prime' : 'composite';
+    const last = attempts.at(-1);
+    if (!required.every(divisor => seen.has(divisor)) ||
+        !(last.accepted || last.reason === 'duplicate') ||
+        !sameEvidence(last.raw,trialInput(model)) || !sameEvidence(model.board.tests,[records]) ||
+        model.answer !== classification || !inspect(task,model).correct) return null;
+
+    return {
+      kind,nodeId,sessionId,index:context.index,value,
+      checkedDivisors:required, factors, classification, attempts,
+      learnerMasteryAssessed:false
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP105PrimeDivisorsEvidence(task,model,record,context) {
+  if (!latestSubmissionMatches(model,record)) return null;
+  return replayP105PrimeDivisorsEvidence(task,model,context);
+}
diff --git a/tests/p9-p105-prime-divisors-browser.cjs b/tests/p9-p105-prime-divisors-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..9cdcdd4b4fbeb935a28bf05a9ee5b014dfa23488
--- /dev/null
+++ b/tests/p9-p105-prime-divisors-browser.cjs
@@ -0,0 +1,264 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P105_ARTIFACTS || path.join(root, 'verification/p9-p105-prime-divisors'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd:root, encoding:'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (value, label) => { assert.ok(value, label); checks.push(label); };
+
+function ordered(value) {
+  if (Array.isArray(value)) return value.map(ordered);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en'))
+      .map(key=>[key, ordered(value[key])]));
+  }
+  return value;
+}
+
+async function openControl(page, selector) {
+  const control = page.locator(selector);
+  assert.equal(await control.count(), 1, 'unique original control: ' + selector);
+  for (let i = 0; i < 8 && !(await control.isVisible()); i++) {
+    const closed = control.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await closed.count(), 1);
+    await closed.locator(':scope > summary').click();
+  }
+  return control;
+}
+
+async function routePosition(page, origin, row) {
+  const url = origin.base + 'learn.html#' + row.id;
+  if (row.index === 0) {
+    ok((await page.goto(url))?.fromServiceWorker() === true, 'original first position opens offline');
+    const start = page.locator('[data-do="start"]');
+    if (await start.isVisible()) await start.click();
+  } else {
+    await page.locator('#actions [data-do="next"]').click();
+    checks.push('native Next reaches position ' + row.index);
+  }
+  await page.waitForFunction(({id,index}) => {
+    const snap = window.mathLesson?.snapshot();
+    return snap?.id === id && snap.index === index;
+  },row);
+}
+
+async function run() {
+  fs.mkdirSync(out, {recursive:true});
+  const {P105_SOURCES, replayP105PrimeDivisorsEvidence, submittedP105PrimeDivisorsEvidence} =
+    await entry('dist/learning/p105-prime-divisors-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const {inspect} = await entry('dist/learning/phase5/b14-model.js');
+  const facts = [
+    {divisors:[1], factors:[1], classification:'neither'},
+    {divisors:[1], factors:[1,2], classification:'prime'},
+    {divisors:[1,2,3,4,5,6,7], factors:[1,3,17,51], classification:'composite'}
+  ];
+  const cases = P105_SOURCES.map((source, i) => {
+    const {sessionId, index} = source;
+    return {source, id:sessionId, index, context:{sessionId,index},
+      task:sessionTaskFor(sessionId,index), ...facts[i]};
+  });
+  const verified = [];
+  let origin, browser, learner, restore, page, browserVersion = null, phase = 'startup';
+
+  function proof(row, snap) {
+    return submittedP105PrimeDivisorsEvidence(row.task, snap.model, snap.record, row.context);
+  }
+  async function observe(p, row, stage) {
+    const result = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({
+      index: row.index, stage, attempts: result.attempts.length,
+      tests: result.model.board.tests, historyLength: result.model.history.length,
+      proof: proof(row, result), storage: result.storage
+    });
+    return result;
+  }
+  async function picture(p, name) {
+    await p.screenshot({path: path.join(out, name)});
+    screenshots.push(name);
+  }
+  async function click(p, selector) {
+    await (await openControl(p, selector)).click();
+  }
+  async function field(p, name, value, select = false) {
+    const loc = await openControl(p, '#extra-controls [data-xfield="' + name + '"]');
+    if (select) await loc.selectOption(String(value));
+    else await loc.fill(String(value));
+    assert.equal(await loc.inputValue(),String(value));
+  }
+
+  try {
+    origin = await createOrigin(root);
+    browser = await chromium.launch({
+      headless: true,
+      args: ['--use-angle=swiftshader','--enable-unsafe-swiftshader'],
+      ...(process.env.MATH_CHROMIUM_EXECUTABLE ? {executablePath:process.env.MATH_CHROMIUM_EXECUTABLE} : {})
+    });
+    browserVersion = browser.version();
+    learner = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow', acceptDownloads:true});
+    restore = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow'});
+    page = await learner.newPage();
+    const restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.setDefaultTimeout(15000);
+      p.on('pageerror', error => errors.push(phase + ': ' + error.message));
+    }
+    for (const context of [learner, restore]) {
+      context.on('request', request => {
+        if (/^https?:/.test(request.url()) && !request.url().startsWith(origin.base)) {
+          errors.push('non-local request: ' + request.url());
+        }
+      });
+    }
+
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P105');
+
+    for (const row of cases) {
+      phase = row.id + ':' + row.index;
+      const tag = row.id + '-' + row.index;
+      await routePosition(page, origin, row);
+      const live = await page.evaluate(async ({id,index}) => {
+        const {sessionTaskFor} = await import('./learning/bridges.js');
+        const {LESSONS} = await import('./learning/catalog.js');
+        return {task:sessionTaskFor(id,index), nodeId:LESSONS[id].topicId};
+      }, row);
+      const digest = createHash('sha256').update(JSON.stringify(ordered(live.task))).digest('hex');
+      ok(live.nodeId === row.source.nodeId && digest === row.source.taskHash, tag + ' source fingerprint');
+      assert.deepEqual(live.task, row.task);
+      ok(await page.evaluate(() => innerWidth === 1920 && innerHeight === 1080), tag + ' standard viewport');
+
+      const n = row.task.ns[0];
+      const trial = async (d,r) => {
+        await field(page,'candidate',d);
+        await field(page,'remainder',r);
+        await click(page,'#extra-visual [data-x="b14-test"][data-side="0"]');
+      };
+      await trial(1,1);
+      const wrongRemainder = await observe(page,row,'wrong-remainder');
+      ok(wrongRemainder.model.board.tests[0].length === 0 && wrongRemainder.model.history.length === 1,
+        tag + ' genuine wrong remainder produces no recorded divisor');
+
+      await trial(1,0);
+      await trial(1,0);
+      for (const d of row.divisors.slice(1)) await trial(d,n % d);
+      await field(page,'answer',row.classification === 'prime' ? 'composite' : 'prime',true);
+      await click(page,'#actions [data-do="check"]');
+      const wrong = await observe(page,row,'wrong-classification');
+      ok(wrong.attempts.length === 1 && !inspect(row.task,wrong.attempts[0].value).correct &&
+        !proof(row,wrong), tag + ' complete trial range with wrong classification fails original Check');
+      await picture(page,tag + '-wrong-classification.png');
+
+      await field(page,'answer',row.classification,true);
+      const draft = await observe(page,row,'corrected-draft');
+      const revised = replayP105PrimeDivisorsEvidence(row.task,draft.model,row.context);
+      assert.deepEqual(revised?.factors,row.factors);
+      ok(!proof(row,draft),tag + ' amended classification requires a fresh Check');
+      await click(page,'#actions [data-do="check"]');
+      const good = await observe(page,row,'correct-check');
+      const accepted = proof(row,good);
+      ok(good.attempts.length === 2 && inspect(row.task,good.attempts.at(-1).value).correct &&
+        accepted?.classification === row.classification,tag + ' actual latest Check has the correct classification');
+      assert.deepEqual(accepted.checkedDivisors,row.divisors);
+      assert.deepEqual(accepted.factors,row.factors);
+      ok(accepted.attempts.filter(attempt => attempt.reason === 'duplicate').length === 1 &&
+        good.model.board.tests[0].length === row.divisors.length,tag + ' repeated divisor adds no extra record');
+      if (n === 51) {
+        ok(accepted.attempts.some(attempt => attempt.accepted && attempt.divisor === 3 &&
+          attempt.quotient === 17 && attempt.remainder === 0), '51 has the distinct complementary factor 17');
+      }
+      ok(await page.locator('#thinking-feedback').count() === 0, tag + ' candidate has no global registration');
+      await picture(page, tag + '-correct-check.png');
+
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' stopped-origin reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      const reloaded = await observe(page, row, 'offline-reload');
+      assert.deepEqual(reloaded.model, good.model);
+      assert.deepEqual(reloaded.record, good.record);
+      assert.deepEqual(proof(row,reloaded), accepted);
+      checks.push(tag + ' raw model and both Checks survive reload');
+      verified.push({row, good, accepted});
+    }
+
+    phase = 'State-v2 backup';
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download');
+    await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    const envelope = JSON.parse(bytes);
+    ok(envelope.app === 'math-explorer' && envelope.version === 2, 'real offline State-v2 export');
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+
+    async function upload(buffer, name) {
+      const chooser = restorePage.waitForEvent('filechooser');
+      await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await chooser).setFiles({name, mimeType:'application/json', buffer});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    }
+    ok((await upload(bytes, 'p105-backup.json')).includes('备份已合并'), 'fresh context imports the backup');
+    const restoredBytes = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p105-repeat.json')).includes('备份已合并'), 'repeat import succeeds');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'repeat import preserves exact bytes');
+    ok(!(await upload(Buffer.from('{'), 'p105-corrupt.json')).includes('备份已合并'), 'corrupt backup is rejected');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'failed import preserves exact bytes');
+    await restorePage.goto(origin.base + 'learn.html#' + cases.at(-1).id);
+    await restorePage.waitForFunction(id => window.mathLesson?.snapshot()?.id === id, cases.at(-1).id);
+    for (const {row, good, accepted} of verified) {
+      const imported = await observe(restorePage,row,'restored-backup');
+      assert.deepEqual(imported.model, good.model);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row,imported), accepted);
+      checks.push(row.index + ' restored model, correction and evidence match exactly');
+    }
+
+    phase = 'Retry';
+    const last = verified.at(-1).row;
+    await page.goto(origin.base + 'learn.html#' + last.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.index);
+    await click(page, '[data-do="p3-retry"]');
+    const retry = await observe(page, last, 'retry');
+    ok(retry.model.history.length === 0 && retry.attempts.length === 2 &&
+      proof(last,retry) === null, 'Retry keeps saved attempts and excludes the new blank draft');
+    ok(errors.length === 0, 'no non-local requests or page errors');
+    console.log('P105_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha:sha,chromium:browserVersion,checks:checks.length,captures:observations.length}));
+  } catch (error) {
+    errors.push(phase + ': ' + (error.stack || error));
+    await page?.screenshot({path:path.join(out, 'failure.png')}).catch(() => {});
+    throw error;
+  } finally {
+    fs.writeFileSync(path.join(out,'results.json'),JSON.stringify({
+      schema:'math-p105-prime-divisors-browser/1', testedCheckoutSha:sha,
+      originalControls:true, seededLessonPositionOnly:false, chromium:browserVersion,
+      viewport:STANDARD_DESKTOP_VIEWPORT, sources:P105_SOURCES,
+      checks, observations, screenshots, errors
+    },null,2)+'\n');
+    await restore?.close().catch(() => {});
+    await learner?.close().catch(() => {});
+    await browser?.close().catch(() => {});
+    await origin?.close().catch(() => {});
+  }
+}
+
+run().catch(error => { console.error(error.stack || error); process.exitCode = 1; });
diff --git a/tests/p9-p105-prime-divisors.test.mjs b/tests/p9-p105-prime-divisors.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..cde9f2865c8e5694a0fff1b1be0a2719e599b176
--- /dev/null
+++ b/tests/p9-p105-prime-divisors.test.mjs
@@ -0,0 +1,125 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {BRIDGES, sessionTaskFor} from '../dist/learning/bridges.js';
+import {ensureB39Ready} from '../dist/learning/phase4/async-batches.js';
+import * as original from '../dist/learning/phase5/b14-model.js';
+import {
+  P105_SOURCES,p105PrimeDivisorsBinding,
+  replayP105PrimeDivisorsEvidence,submittedP105PrimeDivisorsEvidence
+} from '../dist/learning/p105-prime-divisors-evidence.js';
+
+const facts = [
+  {divisors:[1],factors:[1],classification:'neither'},
+  {divisors:[1],factors:[1,2],classification:'prime'},
+  {divisors:[1,2,3,4,5,6,7],factors:[1,3,17,51],classification:'composite'}
+];
+const rows = P105_SOURCES.map((source,i) => {
+  const {sessionId,index} = source;
+  return {source,context:{sessionId,index},task:sessionTaskFor(sessionId,index),...facts[i]};
+});
+
+const replay = (row,model) => replayP105PrimeDivisorsEvidence(row.task,model,row.context);
+const submitted = (row,model,...versions) => submittedP105PrimeDivisorsEvidence(row.task,model,
+  {attempts:versions.map(value => ({value:structuredClone(value)}))},row.context);
+
+function trial(row,model,divisor,remainder = row.task.ns[0] % Number(divisor),data = {side:0}) {
+  model.candidate = String(divisor);
+  model.remainder = String(remainder);
+  original.act(row.task,model,'b14-test',data);
+}
+
+function work(row,divisors = row.divisors) {
+  const model = original.initial(row.task);
+  trial(row,model,0,'0');
+  trial(row,model,1,'1');
+  for (const d of [...divisors].reverse()) trial(row,model,d);
+  model.answer = row.classification;
+  return model;
+}
+
+test('P105 binds the full immutable source for all three positions', () => {
+  assert.equal(rows.length,3);
+  for (const {source,task,context} of rows) {
+    const ordered = Object.fromEntries(Object.entries(task).sort(([a],[b]) => a.localeCompare(b,'en')));
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered)).digest('hex'),source.taskHash);
+    assert.equal(p105PrimeDivisorsBinding(task,context)?.nodeId,source.nodeId);
+    assert.equal(p105PrimeDivisorsBinding({...task,ns:[97]},context),null);
+    assert.equal(p105PrimeDivisorsBinding({...task,mode:'divisible'},context),null);
+    assert.equal(p105PrimeDivisorsBinding(task,{...context,index:String(context.index)}),null);
+  }
+});
+
+test('P105 replays the complete square-root range and reconstructs distinct factor pairs', () => {
+  for (const row of rows) {
+    const model = work(row), before = structuredClone(model);
+    assert.ok(original.inspect(row.task,model).correct);
+    const proof = replay(row,model);
+    assert.deepEqual(proof.checkedDivisors,row.divisors);
+    assert.deepEqual(proof.factors,row.factors);
+    assert.equal(proof.classification,row.classification);
+    assert.deepEqual(proof.attempts.slice(0,2).map(event => event.reason),['outside-range','wrong-remainder']);
+    for (const attempt of proof.attempts.filter(event => event.accepted)) {
+      assert.equal(attempt.divisor * attempt.quotient + attempt.remainder,proof.value);
+    }
+    assert.deepEqual(model,before);
+  }
+});
+
+test('P105 distinguishes the single factor of 1, the prime 2 and the complementary factor 17', () => {
+  const [one,two,odd] = rows;
+  assert.equal(replay(one,work(one)).factors.length,1);
+  assert.equal(replay(two,work(two)).factors.length,2);
+  const model = work(odd);
+  assert.equal(replay(odd,model).attempts.find(item => item.divisor === 3 && item.accepted).quotient,17);
+  trial(odd,model,'03.0','0.0');
+  const proof = replay(odd,model);
+  assert.equal(proof.attempts.at(-1).reason,'duplicate');
+  assert.equal(proof.factors.length,4);
+});
+
+test('P105 requires the latest original Check on a complete and correctly classified work', () => {
+  const row = rows[2];
+  assert.equal(replay(row,work(row,[1,2,3,4,5,6])),null);
+  const model = work(row);
+  model.answer = 'prime';
+  const wrong = structuredClone(model);
+  assert.equal(replay(row,wrong),null);
+  model.answer = 'composite';
+  assert.equal(submitted(row,model,wrong),null);
+  assert.equal(submitted(row,model,wrong,model)?.classification,'composite');
+  assert.equal(submitted(row,model,model,wrong),null);
+  model.remainder = '1';
+  assert.equal(original.inspect(row.task,model).correct,true);
+  assert.equal(replay(row,model),null);
+});
+
+test('P105 rejects forged divisors, hidden action coordinates and an uncorrected wrong remainder', () => {
+  const row = rows[2], changes = [
+    m => { m.history.length = 0; },
+    m => { m.history.at(-1).data.fields.remainder = '1'; },
+    m => { m.board.tests[0][0].d = 8; },
+    m => trial(row,m,2,1,{side:0,index:0}),
+    m => trial(row,m,3,1),
+    m => original.act(row.task,m,'b14-select',{value:3})
+  ];
+  for (const change of changes) {
+    const model = work(row);
+    change(model);
+    assert.equal(replay(row,model),null,change.toString());
+  }
+});
+
