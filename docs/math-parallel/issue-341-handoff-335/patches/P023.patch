+};
+
+  const cases = P023_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP023GraphInterpretationEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
