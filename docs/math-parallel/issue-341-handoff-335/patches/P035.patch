+    "nodeId": "mt_GDtFU5fyUv",
+    "type": "x-p22-grid",
+    "taskHash": "6bd01ab993de1b3784974385cb0da7cb3cbf318c1679f1483650d908a0728682",
+    "task": {
+      "type": "x-p22-grid",
+      "prompt": "换成两种帽子与三种围巾。逐行列出所有搭配，圈出红帽配任意围巾。",
+      "rows": [
+        "红帽",
