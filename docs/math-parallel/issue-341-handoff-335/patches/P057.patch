@@ -0,0 +1,52 @@
+import {initial, inspect, valid} from './phase5/b22-model.js';
+import {hasExactKeys, latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence} from './evidence-contract.js';
+
+const source=Object.freeze({sessionId:'chanceindependent',index:2,nodeId:'mt_dlg6i-Lw0I',type:'x-p22-sort',
+  taskHash:'40b4314474c8ac6309f3282cff942dd91fd5b4f31b15919d511685aff9d03e0e'});
+const taskItems=[
+  ['公平硬币第一次和第二次','independent'],
+  ['两次从3红2蓝的袋中抽珠，每次放回','independent'],
+  ['两次抽珠，第一次拿走红珠不放回','dependent'],
+  ['发出一张牌不放回后再发一张','dependent'],
+  ['两次独立掷公平骰子','independent']
+];
+const original={type:source.type,prompt:'把五对事件分别放进“前一次不改变下一次机会”或“前一次改变袋中比例”。',
+  items:taskItems,questions:[]};
+export const P057_SOURCES=Object.freeze([source]);
+
+export function p057ChanceConditionSortBinding(task,context) {
+  if (context?.sessionId!==source.sessionId || context.index!==source.index ||
+      !sameEvidence(task,original) || !matchesNativeEvidenceTask(task,context,source)) return null;
+  return {nodeId:source.nodeId,kind:'p057-chance-condition-sort',method:null,
+    question:'前一次结束后，下一次面对的袋子、牌堆或随机规则有没有变化？'};
+}
+
+export function replayP057ChanceConditionSortEvidence(task,model,context) {
+  try {
+    const binding=p057ChanceConditionSortBinding(task,context);
+    if (!binding || !hasExactKeys(model,Object.keys(initial(task,1))) || !valid(task,model) ||
+        model.issue!=='' || !model.history.length || Object.keys(model.history).length!==model.history.length) return null;
+    const attempts=[], placed=[];
+    let cursor=0;
+    for (const e of model.history) {
+      if (!hasExactKeys(e,['a','f','d']) || !hasExactKeys(e.d,[]) ||
+          e.a!=='classify' || !hasExactKeys(e.f,['choice']) || cursor>=taskItems.length ||
+          !['','independent','dependent'].includes(e.f.choice)) return null;
+      const choice=e.f.choice;
+      const changesNextConditions=cursor===2 || cursor===3;
+      const accepted=choice===(changesNextConditions?'dependent':'independent');
+      attempts.push({index:cursor,choice,changesNextConditions,accepted});
+      placed[cursor]=choice;
+      if (accepted) cursor++;
+    }
+    if (cursor!==taskItems.length || model.board.cursor!==cursor ||
+        !sameEvidence(placed,model.board.placed) || !inspect(task,model).correct) return null;
+    return {binding,placed,attempts};
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP057ChanceConditionSortEvidence(task,model,record,context) {
+  return latestSubmissionMatches(model,record) ? replayP057ChanceConditionSortEvidence(task,model,context) : null;
+}
diff --git a/tests/p9-p057-chance-condition-sort-browser.cjs b/tests/p9-p057-chance-condition-sort-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..289e81ba4efa792e9216ce225909ec024386b683
--- /dev/null
+++ b/tests/p9-p057-chance-condition-sort-browser.cjs
@@ -0,0 +1,164 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P057_ARTIFACTS || path.join(root, 'verification/p9-p057-chance-condition-sort'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+
+async function openControl(page, sel) {
+  const c = page.locator(sel); assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value));
+      else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' +
+        (s.data?.index !== undefined ? '[data-index="' + s.data.index + '"]' : '') +
+        (s.data?.value !== undefined ? '[data-value="' + s.data.value + '"]' : '');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P057_SOURCES, replayP057ChanceConditionSortEvidence, submittedP057ChanceConditionSortEvidence} = await entry('dist/learning/p057-chance-condition-sort-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b22 = await entry('dist/learning/phase5/b22-model.js');
+  const cases = P057_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP057ChanceConditionSortEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b22.inspect(row.task, r.model).correct, evidence: Boolean(proof(row, r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    page.setDefaultTimeout(10000);
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P057');
+    let lastSid = null, cur = 0;
+    for (const row of cases) {
+      if (row.id !== lastSid) {
+        ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, row.id + ' offline');
+        await page.waitForFunction(() => window.mathLesson);
+        const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+        lastSid = row.id; cur = 0;
+      }
+      while (cur < row.index) {
+        const predecessor=sessionTaskFor(row.id,cur);
+        const steps=b22.solveSteps(predecessor);
+        if (predecessor.type==='x-p22-experiment') {
+          await runSteps(page,steps.filter(step=>step.field!=='rate'));
+          const run=await capture(page,out,row.id+'-'+cur,{id:row.id,index:cur},'prerequisite-run');
+          const hits=run.model.board.draws.filter(value=>value===predecessor.event).length;
+          await runSteps(page,[{field:'rate',value:hits+'/'+run.model.board.draws.length}]);
+        } else {
+          await runSteps(page,steps);
+        }
+        await page.locator('#actions [data-do="check"]').click();
+        await page.locator('#actions [data-do="next"]').click();
+        cur++; await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+      const tag = row.id + '-' + row.index;
+      ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, tag + ' hash');
+      await runSteps(page,[{field:'choice',value:'dependent'},{action:'p22-classify'}]);
+      await page.locator('#actions [data-do="check"]').click();
+      const wrong=await observe(page,row,'wrong-check');
+      ok(wrong.attempts.length===1 && wrong.model.board.cursor===0 &&
+        !b22.inspect(row.task,wrong.model).correct && !proof(row,wrong),'wrong choice preserves the first case');
+      await picture(page,tag+'-wrong.png');
+      await runSteps(page,b22.solveSteps(row.task));
+      const draft=await observe(page,row,'corrected-draft');
+      const replayed=replayP057ChanceConditionSortEvidence(row.task,draft.model,row.context);
+      ok(replayed?.attempts.length===6 && !proof(row,draft),'sorting all cases still awaits a new Check');
+      await page.locator('#actions [data-do="check"]').click();
+      const good=await observe(page,row,'correct-check');
+      const accepted=proof(row,good);
+      ok(good.attempts.length===2 && accepted?.placed.length===5,'latest Check preserves the five choices');
+      await picture(page, tag + '-correct.png');
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      assert.deepEqual(proof(row, await observe(page, row, 'offline-reload')), accepted);
+      verified.push({row, good, accepted});
+      const next = cases[cases.indexOf(row) + 1];
+      if (next && next.id === row.id) {
+        await page.locator('#actions [data-do="next"]').click(); cur++;
+        await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+    }
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p057.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p057r.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb,
+      'corrupt import preserves exact bytes');
+    const last = verified.at(-1);
+    await restorePage.goto(origin.base + 'learn.html#' + last.row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    for (const {row, good, accepted} of verified) {
+      const stage = row.index === last.row.index ? 'restored-backup' : 'restored-storage';
+      const imported = await observe(restorePage, row, stage);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row, imported), accepted);
+      checks.push(row.index + ' imported history and rechecked proof match');
+    }
+    await page.goto(origin.base + 'learn.html#' + last.row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(last.row, await observe(page, last.row, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P057_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p057-chance-condition-sort-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P057_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p057-chance-condition-sort.test.mjs b/tests/p9-p057-chance-condition-sort.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..714bb091ef5b8fe8d91ab4a9f32d1811ce229784
--- /dev/null
+++ b/tests/p9-p057-chance-condition-sort.test.mjs
@@ -0,0 +1,45 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {act,initial} from '../dist/learning/phase5/b22-model.js';
+import {P057_SOURCES,p057ChanceConditionSortBinding,replayP057ChanceConditionSortEvidence,submittedP057ChanceConditionSortEvidence} from '../dist/learning/p057-chance-condition-sort-evidence.js';
+
+const [source]=P057_SOURCES;
+const {sessionId,index}=source;
+const context={sessionId,index};
+const task=sessionTaskFor(sessionId,index);
+const choices=['independent','independent','dependent','dependent','independent'];
+const append=(m,choice)=>{m.choice=choice;act(task,m,'p22-classify');};
+const replay=m=>replayP057ChanceConditionSortEvidence(task,m,context);
+
+test('P057 binds only the exact original five cases',()=>{
+  const sorted=Object.fromEntries(Object.entries(task).sort(([a],[b])=>a.localeCompare(b,'en')));
+  assert.equal(createHash('sha256').update(JSON.stringify(sorted)).digest('hex'),source.taskHash);
+  assert.ok(p057ChanceConditionSortBinding(task,context));
+  assert.equal(p057ChanceConditionSortBinding(task,{sessionId,index:-1}),null);
+  assert.equal(p057ChanceConditionSortBinding({...task,items:[]},context),null);
+});
+
+test('P057 retains incorrect sort attempts and checks change of conditions',()=>{
+  const m=initial(task,1);
+  append(m,'dependent');
+  assert.equal(m.board.cursor,0);
+  assert.equal(replay(m),null);
+  choices.forEach(choice=>append(m,choice));
+  const proof=replay(m);
+  assert.deepEqual(proof?.placed,choices);
+  assert.deepEqual(proof.attempts[0],{index:0,choice:'dependent',changesNextConditions:false,accepted:false});
+  assert.deepEqual(proof.attempts.slice(1).map(a=>a.changesNextConditions),[false,false,true,true,false]);
+});
+
+test('P057 excludes stale Checks and unexpected recorded parameters',()=>{
+  const m=initial(task,1);
+  choices.slice(0,4).forEach(choice=>append(m,choice));
+  const partial=structuredClone(m);
+  append(m,choices[4]);
+  assert.equal(submittedP057ChanceConditionSortEvidence(task,m,{attempts:[{value:partial}]},context),null);
+  assert.ok(submittedP057ChanceConditionSortEvidence(task,m,{attempts:[{value:m}]},context));
+  m.history[0].d.index='0';
+  assert.equal(replay(m),null);
+});
