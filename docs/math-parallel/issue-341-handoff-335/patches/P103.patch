index 0000000000000000000000000000000000000000..c1b01b9ee4b774107cf83d939577d6191a4e7f0f
--- /dev/null
+++ b/dist/learning/p103-pair-grid-evidence.js
@@ -0,0 +1,87 @@
+import {equal} from './phase5/b16-model.js';
+import {initial, inspect, valid} from './phase5/b34-model.js';
+import {
+  hasExactKeys,
+  isEvidenceContext,
+  latestSubmissionMatches,
+  matchesNativeEvidenceTask,
+  sameEvidence
+} from './evidence-contract.js';
+
+const sessionId = 'pairs34';
+const nodeId = 'mt_gu0NPDvlhY';
+const type = 'x-p34-grid';
+const kind = 'p103-pair-grid';
+const reviewed = [
+  {
+    taskHash:'861c09b6e87780c3c7c9279c7cbe081213a96e38cae03900b5e147d51128aabc',
+    task:{
+      type,
+      prompt:'三种前菜与四种主菜，点亮所有不同搭配。',
+      rows:['汤','沙拉','水果'],
+      cols:['饭','面','饼','豆'],
+      questions:[{label:'一共几种搭配',value:12,kind:'number'},{label:'用3×4得到多少',value:12,kind:'number'}]
+    }
+  },
+  {
+    taskHash:'a6ef31c0a1226f12f6e779595a615a1dbefcc574c86410948787bd5d0a7a9cb2',
+    task:{
+      type,
+      prompt:'换成两种饮料和三种点心。按行配完，再看看有没有漏掉。',
+      rows:['水','果汁'],
+      cols:['饼干','面包','水果'],
+      questions:[{label:'一共几种搭配',value:6,kind:'number'}]
+    }
+  }
+];
+
+export const P103_SOURCES = Object.freeze(reviewed.map(({taskHash},index) =>
+  Object.freeze({sessionId,index,nodeId,type,taskHash})
+));
+
+export function p103PairGridBinding(task,context) {
+  if (!isEvidenceContext(context) || context.sessionId !== sessionId ||
+      !sameEvidence(task,reviewed[context.index]?.task) ||
+      !matchesNativeEvidenceTask(task,context,{type,nodeId})) return null;
+  return {nodeId,kind,method:null,question:'每格怎样对应一种搭配？有多少种不同的行列组合？'};
+}
+
+export function replayP103PairGridEvidence(task,model,context) {
+  try {
+    const binding = p103PairGridBinding(task,context);
+    if (!binding || !hasExactKeys(model,Object.keys(initial(task))) || !valid(task,model) ||
+        model.issue !== '' || !model.history.length ||
+        Object.keys(model.history).length !== model.history.length) return null;
+
+    const pairs = task.rows.flatMap((row,rowIndex) => task.cols.map((column,columnIndex) =>
+      ({row,rowIndex,column,columnIndex})));
+    const selected = new Set(), toggles = [];
+    for (const [index,event] of model.history.entries()) {
+      if (!hasExactKeys(event,['a','i','v','w']) || event.a !== 'cell' ||
+          event.v !== '' || event.w !== '' || !/^(0|[1-9]\d*)$/.test(event.i)) return null;
+      const cell = Number(event.i);
+      if (cell >= pairs.length) return null;
+      const added = !selected.delete(cell);
+      if (added) selected.add(cell);
+      toggles.push({index,cell,...pairs[cell],selected:added});
+    }
+
+    const liveCells = [...selected].sort((a,b) => a-b);
+    if (liveCells.length !== pairs.length || !sameEvidence(liveCells,model.board.selected) ||
+        !task.questions.every((q,i) => q.kind === 'number' && q.value === pairs.length && equal(model.answers[i],pairs.length)) ||
+        !inspect(task,model).correct) return null;
+
+    return {
+      kind,nodeId,sessionId,index:context.index,
+      rowCount:task.rows.length,columnCount:task.cols.length,
+      pairs,toggles,learnerMasteryAssessed:false
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP103PairGridEvidence(task,model,record,context) {
+  if (!latestSubmissionMatches(model,record)) return null;
+  return replayP103PairGridEvidence(task,model,context);
+}
diff --git a/tests/p9-p103-pair-grid-browser.cjs b/tests/p9-p103-pair-grid-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..cbc07e56d1d925c79df1402828e78a096b7ab1c4
--- /dev/null
+++ b/tests/p9-p103-pair-grid-browser.cjs
@@ -0,0 +1,255 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P103_ARTIFACTS || path.join(root, 'verification/p9-p103-pair-grid'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd:root, encoding:'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (value, label) => { assert.ok(value, label); checks.push(label); };
+
+function ordered(value) {
+  if (Array.isArray(value)) return value.map(ordered);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en'))
+      .map(key=>[key, ordered(value[key])]));
+  }
+  return value;
+}
+
+async function openControl(page, selector) {
+  const control = page.locator(selector);
+  assert.equal(await control.count(), 1, 'unique original control: ' + selector);
+  for (let i = 0; i < 8 && !(await control.isVisible()); i++) {
+    const closed = control.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await closed.count(), 1);
+    await closed.locator(':scope > summary').click();
+  }
+  return control;
+}
+
+async function routePosition(page, origin, row) {
+  const url = origin.base + 'learn.html#' + row.id;
+  if (row.index === 0) {
+    ok((await page.goto(url))?.fromServiceWorker() === true, 'original first position opens offline');
+    const start = page.locator('[data-do="start"]');
+    if (await start.isVisible()) await start.click();
+  } else {
+    await page.locator('#actions [data-do="next"]').click();
+    checks.push('native Next reaches the second position');
+  }
+  await page.waitForFunction(({id,index}) => {
+    const snap = window.mathLesson?.snapshot();
+    return snap?.id === id && snap.index === index;
+  },row);
+}
+
+async function run() {
+  fs.mkdirSync(out, {recursive:true});
+  const {P103_SOURCES, replayP103PairGridEvidence, submittedP103PairGridEvidence} =
+    await entry('dist/learning/p103-pair-grid-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const {inspect} = await entry('dist/learning/phase5/b34-model.js');
+  const facts = [[3,4,12],[2,3,6]];
+  const cases = P103_SOURCES.map((source, i) => {
+    const {sessionId, index} = source;
+    return {source, id:sessionId, index, context:{sessionId,index},
+      task:sessionTaskFor(sessionId,index), expected:facts[i]};
+  });
+  const verified = [];
+  let origin, browser, learner, restore, page, browserVersion = null, phase = 'startup';
+
+  function proof(row, snap) {
+    return submittedP103PairGridEvidence(row.task, snap.model, snap.record, row.context);
+  }
+  async function observe(p, row, stage) {
+    const result = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({
+      index: row.index, stage, attempts: result.attempts.length,
+      selected: result.model.board.selected, historyLength: result.model.history.length,
+      proof: proof(row, result), storage: result.storage
+    });
+    return result;
+  }
+  async function picture(p, name) {
+    await p.screenshot({path: path.join(out, name)});
+    screenshots.push(name);
+  }
+  async function click(p, selector) {
+    await (await openControl(p, selector)).click();
+  }
+  async function field(p, name, value) {
+    const loc = await openControl(p, '#extra-controls [data-xfield="' + name + '"]');
+    await loc.fill(String(value));
+    assert.equal(await loc.inputValue(),String(value));
+  }
+
+  try {
+    origin = await createOrigin(root);
+    browser = await chromium.launch({
+      headless: true,
+      args: ['--use-angle=swiftshader','--enable-unsafe-swiftshader'],
+      ...(process.env.MATH_CHROMIUM_EXECUTABLE ? {executablePath:process.env.MATH_CHROMIUM_EXECUTABLE} : {})
+    });
+    browserVersion = browser.version();
+    learner = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow', acceptDownloads:true});
+    restore = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow'});
+    page = await learner.newPage();
+    const restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.setDefaultTimeout(15000);
+      p.on('pageerror', error => errors.push(phase + ': ' + error.message));
+    }
+    for (const context of [learner, restore]) {
+      context.on('request', request => {
+        if (/^https?:/.test(request.url()) && !request.url().startsWith(origin.base)) {
+          errors.push('non-local request: ' + request.url());
+        }
+      });
+    }
+
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P103');
+
+    for (const row of cases) {
+      phase = row.id + ':' + row.index;
+      const tag = row.id + '-' + row.index;
+      await routePosition(page, origin, row);
+      const live = await page.evaluate(async ({id,index}) => {
+        const {sessionTaskFor} = await import('./learning/bridges.js');
+        const {LESSONS} = await import('./learning/catalog.js');
+        return {task:sessionTaskFor(id,index), nodeId:LESSONS[id].topicId};
+      }, row);
+      const digest = createHash('sha256').update(JSON.stringify(ordered(live.task))).digest('hex');
+      ok(live.nodeId === row.source.nodeId && digest === row.source.taskHash, tag + ' source fingerprint');
+      assert.deepEqual(live.task, row.task);
+      ok(await page.evaluate(() => innerWidth === 1920 && innerHeight === 1080), tag + ' standard viewport');
+
+      const [rows,columns,total] = row.expected;
+      const grid = page.locator('#extra-visual .p34-pairgrid');
+      assert.deepEqual(await grid.locator('strong').allTextContents(),[...row.task.cols,...row.task.rows]);
+      assert.equal(await grid.locator('[data-x="p34-cell"]').count(),total);
+      const toggle = async i => {
+        const button = grid.locator('[data-x="p34-cell"][data-index="' + i + '"]');
+        assert.equal(await button.count(),1);
+        await button.click();
+        return button.getAttribute('aria-pressed');
+      };
+      ok(await toggle(0) === 'true' && await toggle(0) === 'false',
+        tag + ' actual second click deselects the same cell');
+      for (let i=total-1; i>0; i--) await toggle(i);
+      for (let i=0; i<row.task.questions.length; i++) await field(page,'answers.' + i,total);
+      await click(page,'#actions [data-do="check"]');
+      const wrong = await observe(page,row,'missing-cell-check');
+      ok(wrong.attempts.length === 1 && wrong.model.board.selected.length === total-1 &&
+        !inspect(row.task,wrong.attempts[0].value).correct && !proof(row,wrong),
+        tag + ' entered total cannot replace the missing pair');
+      await picture(page,tag + '-missing-cell-check.png');
+
+      assert.equal(await toggle(0),'true');
+      const draft = await observe(page,row,'complete-draft');
+      const complete = replayP103PairGridEvidence(row.task,draft.model,row.context);
+      assert.deepEqual([complete?.rowCount,complete?.columnCount,complete?.pairs.length],[rows,columns,total]);
+      ok(!proof(row,draft),tag + ' restored cell needs a fresh Check');
+      await click(page,'#actions [data-do="check"]');
+      const good = await observe(page,row,'correct-check');
+      const accepted = proof(row,good);
+      ok(good.attempts.length === 2 && inspect(row.task,good.attempts.at(-1).value).correct &&
+        accepted?.pairs.length === total,tag + ' latest Check verifies the complete Cartesian product');
+      assert.deepEqual(accepted.pairs.map(({row,column}) => [row,column]),
+        row.task.rows.flatMap(label => row.task.cols.map(column => [label,column])));
+      assert.deepEqual(accepted.toggles.filter(event => event.cell === 0)
+        .map(event => event.selected),[true,false,true]);
+      ok(await page.locator('#thinking-feedback').count() === 0, tag + ' candidate has no global registration');
+      await picture(page, tag + '-correct-check.png');
+
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' stopped-origin reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      const reloaded = await observe(page, row, 'offline-reload');
+      assert.deepEqual(reloaded.model, good.model);
+      assert.deepEqual(reloaded.record, good.record);
+      assert.deepEqual(proof(row,reloaded), accepted);
+      checks.push(tag + ' raw model and both Checks survive reload');
+      verified.push({row, good, accepted});
+    }
+
+    phase = 'State-v2 backup';
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download');
+    await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    const envelope = JSON.parse(bytes);
+    ok(envelope.app === 'math-explorer' && envelope.version === 2, 'real offline State-v2 export');
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+
+    async function upload(buffer, name) {
+      const chooser = restorePage.waitForEvent('filechooser');
+      await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await chooser).setFiles({name, mimeType:'application/json', buffer});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    }
+    ok((await upload(bytes, 'p103-backup.json')).includes('备份已合并'), 'fresh context imports the backup');
+    const restoredBytes = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p103-repeat.json')).includes('备份已合并'), 'repeat import succeeds');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'repeat import preserves exact bytes');
+    ok(!(await upload(Buffer.from('{'), 'p103-corrupt.json')).includes('备份已合并'), 'corrupt backup is rejected');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'failed import preserves exact bytes');
+    await restorePage.goto(origin.base + 'learn.html#' + cases.at(-1).id);
+    await restorePage.waitForFunction(id => window.mathLesson?.snapshot()?.id === id, cases.at(-1).id);
+    for (const {row, good, accepted} of verified) {
+      const imported = await observe(restorePage,row,'restored-backup');
+      assert.deepEqual(imported.model, good.model);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row,imported), accepted);
+      checks.push(row.index + ' restored model, correction and evidence match exactly');
+    }
+
+    phase = 'Retry';
+    const last = verified.at(-1).row;
+    await page.goto(origin.base + 'learn.html#' + last.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.index);
+    await click(page, '[data-do="p3-retry"]');
+    const retry = await observe(page, last, 'retry');
+    ok(retry.model.history.length === 0 && retry.attempts.length === 2 &&
+      proof(last,retry) === null, 'Retry keeps saved attempts and excludes the new blank draft');
+    ok(errors.length === 0, 'no non-local requests or page errors');
+    console.log('P103_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha:sha,chromium:browserVersion,checks:checks.length,captures:observations.length}));
+  } catch (error) {
+    errors.push(phase + ': ' + (error.stack || error));
+    await page?.screenshot({path:path.join(out, 'failure.png')}).catch(() => {});
+    throw error;
+  } finally {
+    fs.writeFileSync(path.join(out,'results.json'),JSON.stringify({
+      schema:'math-p103-pair-grid-browser/1', testedCheckoutSha:sha,
+      originalControls:true, seededLessonPositionOnly:false, chromium:browserVersion,
+      viewport:STANDARD_DESKTOP_VIEWPORT, sources:P103_SOURCES,
+      checks, observations, screenshots, errors
+    },null,2)+'\n');
+    await restore?.close().catch(() => {});
+    await learner?.close().catch(() => {});
+    await browser?.close().catch(() => {});
+    await origin?.close().catch(() => {});
+  }
+}
+
+run().catch(error => { console.error(error.stack || error); process.exitCode = 1; });
diff --git a/tests/p9-p103-pair-grid.test.mjs b/tests/p9-p103-pair-grid.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4d634fc1c6fd03e2ed754fa6004de2fdfd6308ab
--- /dev/null
+++ b/tests/p9-p103-pair-grid.test.mjs
@@ -0,0 +1,117 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {BRIDGES, sessionTaskFor} from '../dist/learning/bridges.js';
+import {ensureB39Ready} from '../dist/learning/phase4/async-batches.js';
+import * as original from '../dist/learning/phase5/b34-model.js';
+import {
+  P103_SOURCES,p103PairGridBinding,
+  replayP103PairGridEvidence,submittedP103PairGridEvidence
+} from '../dist/learning/p103-pair-grid-evidence.js';
+
+const facts = [[3,4,12],[2,3,6]];
+const rows = P103_SOURCES.map((source,i) => {
+  const {sessionId,index} = source;
+  return {source,context:{sessionId,index},task:sessionTaskFor(sessionId,index),expected:facts[i]};
+});
+
+function ordered(value) {
+  if (Array.isArray(value)) return value.map(ordered);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.keys(value).sort((a,b) => a.localeCompare(b,'en'))
+      .map(key => [key,ordered(value[key])]));
+  }
+  return value;
+}
+
+const toggle = (row,model,index) => original.act(row.task,model,'p34-cell',{index});
+const replay = (row,model) => replayP103PairGridEvidence(row.task,model,row.context);
+const submit = (row,model,...versions) => submittedP103PairGridEvidence(row.task,model,
+  {attempts:versions.map(value => ({value:structuredClone(value)}))},row.context);
+
+function work(row,includingFirst = true) {
+  const model = original.initial(row.task), total = row.expected[2];
+  toggle(row,model,0);
+  toggle(row,model,0);
+  for (let i=total-1; i>0; i--) toggle(row,model,i);
+  if (includingFirst) toggle(row,model,0);
+  model.answers = row.task.questions.map(() => String(total));
+  return model;
+}
+
+test('P103 binds both complete original task shapes and fingerprints', () => {
+  assert.equal(rows.length,2);
+  for (const {source,task,context} of rows) {
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'),source.taskHash);
+    assert.equal(p103PairGridBinding(task,context)?.nodeId,source.nodeId);
+    assert.equal(p103PairGridBinding({...task,rows:[...task.rows].reverse()},context),null);
+    assert.equal(p103PairGridBinding({...task,cols:[...task.cols,'额外']},context),null);
+    assert.equal(p103PairGridBinding(task,{...context,index:String(context.index)}),null);
+  }
+});
+
+test('P103 independently enumerates and replays every labeled pair', () => {
+  for (const row of rows) {
+    const model = work(row), before = structuredClone(model);
+    const proof = replay(row,model);
+    assert.deepEqual([proof.rowCount,proof.columnCount,proof.pairs.length],row.expected);
+    assert.deepEqual(proof.pairs.map(pair => [pair.row,pair.column]),
+      row.task.rows.flatMap(label => row.task.cols.map(column => [label,column])));
+    assert.deepEqual(proof.toggles.filter(x => x.cell === 0).map(x => x.selected),[true,false,true]);
+    assert.deepEqual(model,before);
+  }
+});
+
+test('P103 requires every pair and the count in every original answer field', () => {
+  for (const row of rows) {
+    const missing = work(row,false);
+    assert.equal(original.inspect(row.task,missing).correct,false);
+    assert.equal(replay(row,missing),null);
+    toggle(row,missing,0);
+    assert.ok(replay(row,missing));
+    missing.answers[0] = String(row.expected[2]*2) + '/2';
+    assert.ok(replay(row,missing));
+    missing.answers[missing.answers.length-1] = String(row.expected[2]+1);
+    assert.equal(replay(row,missing),null);
+  }
+});
+
+test('P103 does not use an older Check after a cell is changed and reselected', () => {
+  const row = rows[0], old = work(row), changed = structuredClone(old);
+  toggle(row,changed,0);
+  toggle(row,changed,0);
+  assert.equal(original.inspect(row.task,changed).correct,true);
+  assert.equal(submit(row,changed,old),null);
+  assert.equal(submit(row,changed,old,changed)?.pairs.length,12);
+  assert.equal(submit(row,changed,changed,old),null);
+});
+
+test('P103 excludes forged cells, unsupported actions and duplicate saved IDs', () => {
+  const row = rows[1];
+  for (const change of [
+    m => { m.history.length=0; },
+    m => { m.history[0].i='00'; },
+    m => { m.history[0].i='6'; },
+    m => { m.history[0].w='unexpected'; },
+    m => { m.board.selected[1]=0; },
+    m => original.act(row.task,m,'p34-undo')
+  ]) {
+    const model = work(row);
+    change(model);
+    assert.equal(replay(row,model),null,change.toString());
+  }
+});
+
+test('P103 excludes related pairing mode, actual practice and bridge positions', async () => {
+  await ensureB39Ready();
+  for (const {task,context} of rows) {
+    assert.equal(p103PairGridBinding(task,{...context,index:-1}),null);
+    assert.equal(p103PairGridBinding(task,{sessionId:'paired34',index:0}),null);
+    assert.equal(p103PairGridBinding(sessionTaskFor('paired34',0),context),null);
