+    "index": 0,
+    "nodeId": "mt_mN4Ye_vtR7",
+    "type": "x-s23-objects",
+    "taskHash": "d4fa8db3dddcab3af8fea3faacfeee321a7f14ca1f6a67e212665b2f283c2a2d",
