@@ -0,0 +1,72 @@
+import {initial, inspect, valid, number} from './phase5/b14-model.js';
+import {hasExactKeys, isEvidenceContext, latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence} from './evidence-contract.js';
+
+const sessionId = 'bigproduct', index = 2, nodeId = 'mt_XLP1IM3Qbb', type = 'x-multable';
+const taskHash = "93c94b11850b6790d18c4ed0709321802d6fc61bd91793ee18c6a95e02fd48c7", reviewed = {"type":"x-multable","a":3040,"b":20,"estimate":3000,"prompt":"3040×20：遇到0也留下位置，别把20读成2。"};
+export const P062_SOURCES = Object.freeze([Object.freeze({sessionId, index, nodeId, type, taskHash})]);
+
+export function p062ZeroPlaceProductBinding(task, context) {
+  if (!isEvidenceContext(context) || context.sessionId !== sessionId || context.index !== index ||
+      !sameEvidence(task, reviewed) || !matchesNativeEvidenceTask(task, context, {type, nodeId})) return null;
+  return {nodeId, kind: 'p062-zero-place-product', method: null, question: '为什么 3040 × 20 即使不需要进位，也要保留 0 的数位并把第二行左移一位得到 60800？'};
+}
+
+export function replayP062ZeroPlaceProductEvidence(task, model, context) {
+  try {
+    const binding = p062ZeroPlaceProductBinding(task, context);
+    if (!binding || !hasExactKeys(model, Object.keys(initial(task))) || !valid(task, model) ||
+        model.issue !== '' || !model.history.length || Object.keys(model.history).length !== model.history.length) return null;
+
+    const ds = [0, 4, 0, 3]; // 3040 reversed
+    const ms = [0, 2];       // 20 reversed
+    let firstEstimate = null, estimateOK = false, row = 0, col = 0, carry = 0, pending = null;
+    let digits = [], rows = [], work = [], failedEvents = 0, resets = 0, lastIssue = '';
+
+    for (const ev of model.history) {
+      if (!ev || !ev.data || !ev.data.fields) return null;
+      const a = ev.action, f = ev.data.fields;
+      lastIssue = '';
+      if (a === 'b14-reset') {
+        estimateOK = false; row = 0; col = 0; carry = 0; pending = null; digits = []; rows = []; work = []; resets++;
+      } else if (a === 'b14-estimate') {
+        firstEstimate ??= f.estimate;
+        if (number(f.estimate) !== task.estimate * task.b) { lastIssue = 'bad-est'; failedEvents++; }
+        else estimateOK = true;
+      } else if (a === 'b14-mul-count') {
+        if (!estimateOK || row >= ms.length || col >= ds.length || pending) return null;
+        const total = ds[col] * ms[row] + carry;
+        if (number(f.raw) !== total) { lastIssue = 'bad-raw'; failedEvents++; }
+        else pending = {raw: total, loose: total, bundles: 0};
+      } else if (a === 'b14-trade') {
+        if (!pending || pending.loose < 10) { lastIssue = 'bad-trade'; failedEvents++; }
+        else { pending.loose -= 10; pending.bundles++; }
+      } else if (a === 'b14-digit') {
+        if (!pending) return null;
+        if (pending.loose >= 10 || number(f.digit) !== pending.loose) { lastIssue = 'bad-digit'; failedEvents++; }
+        else {
+          work.push({row, col, raw: pending.raw, loose: pending.loose, bundles: pending.bundles, incoming: carry});
+          digits.push(pending.loose); carry = pending.bundles; pending = null; col++;
+        }
+      } else if (a === 'b14-row') {
+        if (col !== ds.length || row >= ms.length) return null;
+        const rowVal = task.a * ms[row] * (10 ** row);
+        if (number(f.shift) !== row || number(f.rowvalue) !== rowVal) { lastIssue = 'bad-row'; failedEvents++; }
+        else { rows.push({value: rowVal, shift: row, digits: [...digits], carry}); row++; col = 0; carry = 0; digits = []; }
+      } else return null;
+    }
+
+    const exactProduct = 3040 * 20;
+    const replayedSum = rows.reduce((s, r) => s + r.value, 0);
+    if (lastIssue !== '' || !estimateOK || row !== 2 || col !== 0 || pending !== null ||
+        rows.length !== 2 || work.length !== 8 || replayedSum !== exactProduct ||
+        !sameEvidence(rows, model.board.rows) || !sameEvidence(work, model.board.work) ||
+        number(model.answer) !== exactProduct || !inspect(task, model).correct) return null;
+
+    return {binding, product: exactProduct, rows: rows.map(r => r.value), workCount: work.length, failedEvents, resets};
+  } catch { return null; }
+}
+
+export function submittedP062ZeroPlaceProductEvidence(task, model, record, context) {
+  if (!latestSubmissionMatches(model, record)) return null;
+  return replayP062ZeroPlaceProductEvidence(task, model, context);
+}
diff --git a/tests/p9-p062-zero-place-product-browser.cjs b/tests/p9-p062-zero-place-product-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..4d42288e43c43a71dd4a35c67acaf6097a9da25f
--- /dev/null
+++ b/tests/p9-p062-zero-place-product-browser.cjs
@@ -0,0 +1,143 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P062_ARTIFACTS || path.join(root, 'verification/p9-p062-zero-place-product'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+
+async function openControl(page, sel) {
+  let c = page.locator(sel);
+  if (await c.count() === 0 && sel.startsWith('#extra-controls ')) c = page.locator(sel.replace('#extra-controls ', '#extra-visual '));
+  assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value));
+      else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' + Object.entries(s.data || {}).map(([k, v]) => '[data-' + k + '="' + v + '"]').join('');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P062_SOURCES, replayP062ZeroPlaceProductEvidence, submittedP062ZeroPlaceProductEvidence} = await entry('dist/learning/p062-zero-place-product-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b14 = await entry('dist/learning/phase5/b14-model.js');
+  const cases = P062_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP062ZeroPlaceProductEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b14.inspect(row.task, r.model).correct, evidence: Boolean(proof(row, r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P062');
+    let lastSid = null, cur = 0;
+    for (const row of cases) {
+      if (row.id !== lastSid) {
+        ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, row.id + ' offline');
+        await page.waitForFunction(() => window.mathLesson);
+        const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+        lastSid = row.id; cur = 0;
+      }
+      while (cur < row.index) {
+        await runSteps(page, b14.solveSteps(sessionTaskFor(row.id, cur)));
+        await page.locator('#actions [data-do="check"]').click();
+        await page.locator('#actions [data-do="next"]').click();
+        cur++; await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+      const tag = row.id + '-' + row.index;
+      ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, tag + ' hash');
+      await runSteps(page, b14.solveSteps(row.task)); await (await openControl(page, '#extra-controls [data-xfield="answer"]')).fill('6080');
+      await page.locator('#actions [data-do="check"]').click();
+      ok(!proof(row, await observe(page, row, 'wrong-check')), tag + ' wrong rejected');
+      await picture(page, tag + '-wrong.png');
+      await (await openControl(page, '#extra-controls [data-xfield="answer"]')).fill('60800');
+      const draft = await observe(page, row, 'corrected-draft');
+      ok(Boolean(replayP062ZeroPlaceProductEvidence(row.task, draft.model, row.context)) && !proof(row, draft), tag + ' needs Check');
+      await page.locator('#actions [data-do="check"]').click();
+      const good = await observe(page, row, 'correct-check');
+      const accepted = proof(row, good);
+      ok(good.attempts.length === 2 && Boolean(accepted), tag + ' verified');
+      await picture(page, tag + '-correct.png');
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      assert.deepEqual(proof(row, await observe(page, row, 'offline-reload')), accepted);
+      verified.push({row, good, accepted});
+      const next = cases[cases.indexOf(row) + 1];
+      if (next && next.id === row.id) {
+        await page.locator('#actions [data-do="next"]').click(); cur++;
+        await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+    }
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p062.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p062r.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    const last = verified.at(-1);
+    await restorePage.goto(origin.base + 'learn.html#' + last.row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    assert.deepEqual(proof(last.row, await observe(restorePage, last.row, 'restored-backup')), last.accepted);
+    await page.goto(origin.base + 'learn.html#' + last.row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(last.row, await observe(page, last.row, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P062_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p062-zero-place-product-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P062_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p062-zero-place-product.test.mjs b/tests/p9-p062-zero-place-product.test.mjs
