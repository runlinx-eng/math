+    "index": 2,
+    "nodeId": "mt_KB_Czd7RQH",
+    "type": "x-g26-trig",
+    "taskHash": "7ff827920ad23f4d46b0aca6fe3ce8e4d6c765a1b30a9ad3e4013e62bef5a2b7",
+    "task": {
+      "type": "x-g26-trig",
+      "prompt": "从B角看：角是35°，斜边长10。选择关系，求对边；结果保留两位小数。",
