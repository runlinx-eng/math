index 0000000000000000000000000000000000000000..55edd678bb787c68cf7dd1afa2d6d57c7580d00c
--- /dev/null
+++ b/dist/learning/p031-hundred-chart-evidence.js
@@ -0,0 +1,106 @@
+import {initial, inspect, valid} from './phase5/b39-model.js';
+import {hasExactKeys, isEvidenceContext, latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence} from './evidence-contract.js';
+
+const reviewed = [
+  {
+    "sessionId": "pattern39",
+    "index": 0,
+    "nodeId": "mt_RFeVlw0QvX",
+    "type": "x-s39-chart",
+    "taskHash": "5431b2af50e42e0f0f91d0f74607fbfc6cfa40ec4d4594e66fc9ef556f751822",
+    "task": {
+      "type": "x-s39-chart",
+      "prompt": "从2出发，每次加2，猜接下来的三站。",
+      "start": 2,
+      "step": 2,
+      "count": 3,
+      "judgment": "even"
+    }
+  },
+  {
+    "sessionId": "pattern39",
+    "index": 1,
+    "nodeId": "mt_RFeVlw0QvX",
+    "type": "x-s39-chart",
+    "taskHash": "ef7d0dee13132e4b2481c17a7a2340d61a85a57c5d8878d6fdd9476bfbb09f6e",
+    "task": {
+      "type": "x-s39-chart",
+      "prompt": "起点改成3，每次加2。这次停在哪里？",
+      "start": 3,
+      "step": 2,
+      "count": 3,
+      "judgment": "odd"
+    }
+  },
+  {
+    "sessionId": "pattern39",
+    "index": 2,
+    "nodeId": "mt_RFeVlw0QvX",
+    "type": "x-s39-chart",
+    "taskHash": "f5e064c4a66c39e6baac10d31504b9d93f5ab67dc15ad87bca07c67d71bb1e47",
+    "task": {
+      "type": "x-s39-chart",
+      "prompt": "从19开始每次加1。经过行末后会去哪里？",
+      "start": 19,
+      "step": 1,
+      "count": 2,
+      "judgment": null
+    }
+  },
+  {
+    "sessionId": "pattern39",
+    "index": 3,
+    "nodeId": "mt_RFeVlw0QvX",
+    "type": "x-s39-chart",
+    "taskHash": "3f630341e6ded0ad9248e260b63a790d6520b7dee95711a6b05c5f6464c9ef7f",
+    "task": {
+      "type": "x-s39-chart",
+      "prompt": "百数表每行10个数。从24出发，每次加10。",
+      "start": 24,
+      "step": 10,
+      "count": 3,
+      "judgment": null
+    }
+  }
+];
+export const P031_SOURCES = Object.freeze(reviewed.map(({task, ...source}) => Object.freeze(source)));
+export function p031HundredChartBinding(task, context) {
+  if (!isEvidenceContext(context)) return null;
+  const entry = reviewed.find(source => source.sessionId === context.sessionId && source.index === context.index);
+  if (!entry || !sameEvidence(task, entry.task) || !matchesNativeEvidenceTask(task, context, entry)) return null;
+  return {nodeId:entry.nodeId, kind:'p031-hundred-chart', method:null, question:"从当前数字按同一个步长走，下一站在哪里？"};
+}
+export function replayP031HundredChartEvidence(task, model, context) {
+  try {
+    const binding = p031HundredChartBinding(task, context);
+    if (!binding || !hasExactKeys(model, Object.keys(initial(task))) || !valid(task, model) ||
+        model.issue !== '' || !model.history.length || Object.keys(model.history).length !== model.history.length) return null;
+    let current = task.start;
+    let first = null;
+    let bad = false;
+    let passed = 0;
+    const moves = [];
+    for (const event of model.history) {
+      if (!hasExactKeys(event,['a','i','v','w','c']) || event.a !== 'hop' || event.i !== '' ||
+          event.w !== '' || event.c !== '' || passed >= task.count) return null;
+      first ??= event.v;
+      const raw = event.v.trim();
+      const next = current + task.step;
+      const correct = /^-?(?:\d+(?:\.\d{1,8})?|\.\d{1,8})$/.test(raw) && Number(raw) === next;
+      moves.push({from:current,guess:event.v,to:next,correct});
+      if (correct) {
+        current = next;
+        passed++;
+      } else bad = true;
+    }
+    if (passed !== task.count || model.guess !== '' || (task.judgment && model.judgment !== (current % 2 ? 'odd' : 'even')) ||
+        !sameEvidence({current,moves,first,bad},model.board) || !inspect(task,model).correct) return null;
+    return {binding, step:task.step, current, moves};
+
+  } catch {
+    return null;
+  }
+}
+export function submittedP031HundredChartEvidence(task, model, record, context) {
+  return latestSubmissionMatches(model, record) ? replayP031HundredChartEvidence(task, model, context) : null;
+}
diff --git a/tests/p9-p031-hundred-chart-browser.cjs b/tests/p9-p031-hundred-chart-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..1b8e8d6de8a3374edbb8269e74979612847231f6
--- /dev/null
+++ b/tests/p9-p031-hundred-chart-browser.cjs
@@ -0,0 +1,159 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P031_ARTIFACTS || path.join(root, 'verification/p9-p031-hundred-chart'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+
+async function openControl(page, sel) {
+  let c = page.locator(sel);
+  if (!(await c.count())) c = page.locator(sel.replace('#extra-controls ', '#extra-visual '));
+  assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value));
+      else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' +
+        Object.entries(s.data || {}).map(([key,value]) => '[data-' + key + '="' + value + '"]').join('');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P031_SOURCES, replayP031HundredChartEvidence, submittedP031HundredChartEvidence} = await entry('dist/learning/p031-hundred-chart-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b39 = await entry('dist/learning/phase5/b39-model.js');
+  const {ensureB39Ready} = await entry('dist/learning/phase4/async-batches.js');
+  await ensureB39Ready();
+  const cases = P031_SOURCES.map(s => ({source: s, id: s.sessionId, index: s.index, context: {sessionId: s.sessionId, index: s.index}, task: sessionTaskFor(s.sessionId, s.index)}));
+  const verified = [];
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = (row, snap) => submittedP031HundredChartEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, row, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b39.inspect(row.task, r.model).correct, evidence: Boolean(proof(row, r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P031');
+    let lastSid = null, cur = 0;
+    for (const row of cases) {
+      if (row.id !== lastSid) {
+        if (lastSid) await page.goto(origin.base + 'v2.html#trail');
+        ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, row.id + ' offline');
+        await page.waitForFunction(() => window.mathLesson);
+        const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+        lastSid = row.id; cur = 0;
+      }
+      while (cur < row.index) {
+        const prior=sessionTaskFor(row.id,cur);
+        await runSteps(page,[b39].find(model => model.TYPES.has(prior.type)).solveSteps(prior));
+        await page.locator('#actions [data-do="check"]').click();
+        await page.locator('#actions [data-do="next"]').click();
+        cur++; await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+      const tag = row.id + '-' + row.index;
+      ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, tag + ' hash');
+      await runSteps(page,[{field:'guess',value:0},{action:'s39-hop'}]);
+      await page.locator('#actions [data-do="check"]').click();
+      const wrong=await observe(page,row,'wrong-check');
+      ok(wrong.attempts.length===1 && !b39.inspect(row.task,wrong.model).correct && !proof(row,wrong),
+        'the incorrect first step fails the original Check');
+      await picture(page,tag+'-wrong.png');
+      await runSteps(page,b39.solveSteps(row.task));
+      const draft=await observe(page,row,'corrected-draft');
+      const replayed=replayP031HundredChartEvidence(row.task,draft.model,row.context);
+      ok(Boolean(replayed) && !proof(row,draft),'correction awaits a fresh Check');
+      await page.locator('#actions [data-do="check"]').click();
+      const good=await observe(page,row,'correct-check');
+      const accepted=proof(row,good);
+      ok(good.attempts.length===2 && (Boolean(accepted)),'new Check preserves all steps');
+      await picture(page, tag + '-correct.png');
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      assert.deepEqual(proof(row, await observe(page, row, 'offline-reload')), accepted);
+      verified.push({row, good, accepted});
+      const next = cases[cases.indexOf(row) + 1];
+      if (next && next.id === row.id) {
+        await page.locator('#actions [data-do="next"]').click(); cur++;
+        await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur);
+      }
+    }
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p031.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p031r.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb,
+      'corrupt import preserves exact bytes');
+    const last = verified.at(-1);
+    await restorePage.goto(origin.base + 'learn.html#' + last.row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    for (const {row, good, accepted} of verified) {
+      const stage = row.index === last.row.index ? 'restored-backup' : 'restored-storage';
+      const imported = await observe(restorePage, row, stage);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row, imported), accepted);
+      checks.push(row.index + ' imported history and rechecked proof match');
+    }
+    await page.goto(origin.base + 'learn.html#' + last.row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(last.row, await observe(page, last.row, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P031_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p031-hundred-chart-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P031_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p031-hundred-chart.test.mjs b/tests/p9-p031-hundred-chart.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..40a7787df43ba22fffe5bb87044938744fad8a9a
--- /dev/null
+++ b/tests/p9-p031-hundred-chart.test.mjs
@@ -0,0 +1,46 @@
+import {ensureB39Ready} from '../dist/learning/phase4/async-batches.js';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import {act, initial, solveSteps} from '../dist/learning/phase5/b39-model.js';
+import {P031_SOURCES, p031HundredChartBinding, replayP031HundredChartEvidence, submittedP031HundredChartEvidence} from '../dist/learning/p031-hundred-chart-evidence.js';
+
+const ordered = value => Array.isArray(value) ? value.map(ordered) : value && typeof value === 'object'
+  ? Object.fromEntries(Object.keys(value).sort((a,b) => a.localeCompare(b,'en')).map(key => [key, ordered(value[key])]))
+  : value;
+
+await ensureB39Ready();
+
+for (const source of P031_SOURCES) {
+  const {sessionId, index} = source;
+  const context = {sessionId, index};
+  const task = sessionTaskFor(sessionId, index);
+  const replay = model => replayP031HundredChartEvidence(task, model, context);
+  const submit = (model, saved) => submittedP031HundredChartEvidence(task, model, {attempts:[{value:saved}]}, context);
+  const play = (model, steps) => {
+    for (const step of steps) {
+      if (step.field) {
+        if (step.field.startsWith('answers.')) model.answers[Number(step.field.split('.')[1])] = step.value;
+        else model[step.field] = step.value;
+      } else act(task, model, step.action === 'turn-extra' ? 'a30-turn' : step.action, step.data);
+    }
+  };
+  test(`P031 locks ${sessionId}:${index} and rejects stale or modified work`, () => {
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), source.taskHash);
+    assert.ok(p031HundredChartBinding(task, context));
+    assert.equal(p031HundredChartBinding(task, {sessionId,index:-1}), null);
+    const model = initial(task);
+    play(model, [{field:'guess',value:0},{action:'s39-hop'}]);
+    const failed = structuredClone(model);
+    assert.equal(replay(model), null);
+    play(model, solveSteps(task));
+    const accepted = replay(model);
+    assert.ok(accepted);
+    assert.equal(submit(model, failed), null);
+    assert.deepEqual(submit(model, structuredClone(model)), accepted);
+    const forged = structuredClone(model);
+    forged.history = [];
+    assert.equal(replay(forged), null);
+  });
+}
