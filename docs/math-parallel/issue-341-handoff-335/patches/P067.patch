+import {rational} from './phase5/b16-model.js';
+import {initial, inspect, valid} from './phase5/b37-model.js';
+import {hasExactKeys, isEvidenceContext, latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence} from './evidence-contract.js';
+
+const sessionId = "similar37", index = 3, nodeId = "mt_2OtRUM_0zW", type = 'x-r37-steps';
+const taskHash = "25d9a986bda4c2e3c8c7180318fe00a0c7dcbfbd8beec961363c4028a4d8c6ad", expectedSteps = [2,2,2];
+const reviewed = {
+  "type": "x-r37-steps",
+  "prompt": "一个三角形的边是3、4、5，另一个对应边是6、8、10。",
+  "scene": "比较每一对对应边。",
+  "steps": [
+    {
+      "title": "第一对",
+      "label": "6是3的几倍",
+      "value": 2
+    },
+    {
+      "title": "第二对",
+      "label": "8是4的几倍",
+      "value": 2
+    },
+    {
+      "title": "第三对",
+      "label": "10是5的几倍",
+      "value": 2
+    }
+  ],
+  "questions": []
+};
+export const P067_SOURCES = Object.freeze([Object.freeze({sessionId, index, nodeId, type, taskHash})]);
+
+export function p067SimilarStepsBinding(task, context) {
+  if (!isEvidenceContext(context) || context.sessionId !== sessionId || context.index !== index ||
+      !sameEvidence(task, reviewed) || !matchesNativeEvidenceTask(task, context, {type, nodeId})) return null;
+  return {nodeId, kind: 'p067-similar-steps', method: null, question: "为什么三对对应边的倍数都等于 2，说明两个三角形按同一比例放大？"};
+}
+
+function exactEqual(raw, target) {
+  const r = rational(String(raw).trim().replace(/\s*\/\s*/g, '/'));
+  return Boolean(r && r[1] > 0 && BigInt(r[0]) === BigInt(target) * BigInt(r[1]));
+}
+
+export function replayP067SimilarStepsEvidence(task, model, context) {
+  try {
+    const binding = p067SimilarStepsBinding(task, context);
+    if (!binding || !hasExactKeys(model, Object.keys(initial(task))) || !valid(task, model) ||
+        model.issue !== '' || !model.history.length || Object.keys(model.history).length !== model.history.length) return null;
+    let stepIdx = 0, failedSteps = 0;
+    const accepted = [];
+    for (const ev of model.history) {
+      if (!hasExactKeys(ev, ['a', 'i', 'v', 'w', 'c']) || ev.a !== 'step' || ev.i !== '' || ev.w !== '' || ev.c !== '') return null;
+      if (stepIdx >= expectedSteps.length) return null;
+      if (exactEqual(ev.v, expectedSteps[stepIdx])) { accepted.push({index: stepIdx, value: expectedSteps[stepIdx], raw: ev.v}); stepIdx++; }
+      else failedSteps++;
+    }
+    if (stepIdx !== expectedSteps.length || model.board.index !== expectedSteps.length ||
+        model.board.records.length !== accepted.length + failedSteps || !inspect(task, model).correct) return null;
+    return {binding, steps: accepted, failedSteps};
+  } catch { return null; }
+}
+
+export function submittedP067SimilarStepsEvidence(task, model, record, context) {
+  if (!latestSubmissionMatches(model, record)) return null;
+  return replayP067SimilarStepsEvidence(task, model, context);
+}
diff --git a/tests/p9-p067-similar-steps-browser.cjs b/tests/p9-p067-similar-steps-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..b5570b51cf576db508c3532f823a1eea784ea6a1
--- /dev/null
+++ b/tests/p9-p067-similar-steps-browser.cjs
@@ -0,0 +1,133 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P067_ARTIFACTS || path.join(root, 'verification/p9-p067-similar-steps'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd: root, encoding: 'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (v, l) => { assert.ok(v, l); checks.push(l); };
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+async function openControl(page, sel) {
+  let c = page.locator(sel);
+  if (await c.count() === 0 && sel.startsWith('#extra-controls ')) c = page.locator(sel.replace('#extra-controls ', '#extra-visual '));
+  assert.equal(await c.count(), 1, 'unique: ' + sel);
+  for (let i = 0; i < 8 && !(await c.isVisible()); i++) {
+    const cl = c.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await cl.count(), 1); await cl.locator(':scope > summary').click();
+  }
+  return c;
+}
+async function runSteps(page, steps) {
+  for (const s of steps) {
+    if (s.field) {
+      const inp = await openControl(page, '#extra-controls [data-xfield="' + s.field + '"]');
+      if (await inp.evaluate(el => el.tagName) === 'SELECT') await inp.selectOption(String(s.value)); else await inp.fill(String(s.value));
+    } else {
+      const sel = '#extra-controls [data-x="' + s.action + '"]' + Object.entries(s.data || {}).map(([k, v]) => '[data-' + k + '="' + v + '"]').join('');
+      await (await openControl(page, sel)).click();
+    }
+  }
+}
+async function run() {
+  fs.mkdirSync(out, {recursive: true});
+  const {P067_SOURCES, replayP067SimilarStepsEvidence, submittedP067SimilarStepsEvidence} = await entry('dist/learning/p067-similar-steps-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const b37 = await entry('dist/learning/phase5/b37-model.js');
+  const b24 = await entry('dist/learning/phase5/b24-model.js');
+  const [source] = P067_SOURCES;
+  const row = {source, id: source.sessionId, index: source.index, context: {sessionId: source.sessionId, index: source.index}, task: sessionTaskFor(source.sessionId, source.index)};
+  let origin, browser, learner, restore, page, restorePage, browserVersion = null;
+  const proof = snap => submittedP067SimilarStepsEvidence(row.task, snap.model, snap.record, row.context);
+  async function observe(p, stage) {
+    const r = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({index: row.index, stage, attempts: r.attempts.length, correct: b37.inspect(row.task, r.model).correct, evidence: Boolean(proof(r))});
+    return r;
+  }
+  async function picture(p, n) { await p.screenshot({path: path.join(out, n), fullPage: true}); screenshots.push(n); }
+  try {
+    origin = await createOrigin(root); browser = await chromium.launch({headless: true}); browserVersion = browser.version();
+    learner = await newDesktopContext(browser); restore = await newDesktopContext(browser);
+    page = await learner.newPage(); restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.on('pageerror', err => errors.push(err.message));
+      p.on('request', req => { if (!req.url().startsWith(origin.base) && !req.url().startsWith('data:') && !req.url().startsWith('blob:')) errors.push(req.url()); });
+    }
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P067');
+    ok((await page.goto(origin.base + 'learn.html#' + row.id))?.fromServiceWorker() === true, 'opens offline');
+    await page.waitForFunction(() => window.mathLesson);
+    const start = page.locator('[data-do="start"]'); if (await start.isVisible()) await start.click();
+    for (let cur = 0; cur < row.index; cur++) {
+      const pre = sessionTaskFor(row.id, cur);
+      await runSteps(page, b37.TYPES.has(pre.type) ? b37.solveSteps(pre) : b24.solveSteps(pre));
+      await page.locator('#actions [data-do="check"]').click();
+      await page.locator('#actions [data-do="next"]').click();
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, cur + 1);
+    }
+    ok(createHash('sha256').update(JSON.stringify(ordered(row.task))).digest('hex') === row.source.taskHash, 'hash');
+    await (await openControl(page, '#extra-controls [data-xfield="value"]')).fill('99999');
+    await (await openControl(page, '#extra-controls [data-x="r37-step"]')).click();
+    await page.locator('#actions [data-do="check"]').click();
+    ok(!proof(await observe(page, 'wrong-step')), 'wrong rejected');
+    await picture(page, row.id + '-' + row.index + '-wrong.png');
+    for (const s of row.task.steps) {
+      await (await openControl(page, '#extra-controls [data-xfield="value"]')).fill(String(s.value));
+      await (await openControl(page, '#extra-controls [data-x="r37-step"]')).click();
+    }
+    const draft = await observe(page, 'corrected-draft');
+    ok(Boolean(replayP067SimilarStepsEvidence(row.task, draft.model, row.context)) && !proof(draft), 'needs Check');
+    await page.locator('#actions [data-do="check"]').click();
+    const good = await observe(page, 'correct-check');
+    const accepted = proof(good);
+    ok(good.attempts.length === 2 && Boolean(accepted), 'verified');
+    await picture(page, row.id + '-' + row.index + '-correct.png');
+    ok((await page.reload())?.fromServiceWorker() === true, 'reload');
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+    assert.deepEqual(proof(await observe(page, 'offline-reload')), accepted);
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download'); await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+    const upload = async (buf, name) => {
+      const ch = restorePage.waitForEvent('filechooser'); await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await ch).setFiles({name, mimeType: 'application/json', buffer: buf});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    };
+    ok((await upload(bytes, 'p067.json')).includes('备份已合并'), 'import');
+    const rb = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p067r.json')).includes('备份已合并'), 'repeat');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === rb, 'idempotent');
+    ok(!(await upload(Buffer.from('{'), 'bad.json')).includes('备份已合并'), 'corrupt');
+    await restorePage.goto(origin.base + 'learn.html#' + row.id);
+    await restorePage.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+    assert.deepEqual(proof(await observe(restorePage, 'restored-backup')), accepted);
+    await page.goto(origin.base + 'learn.html#' + row.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+    await (await openControl(page, '[data-do="p3-retry"]')).click();
+    ok(proof(await observe(page, 'retry')) === null, 'retry');
+    ok(errors.length === 0, 'no errors');
+    console.log('P067_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha: sha, chromium: browserVersion, checks: checks.length, captures: observations.length}));
+  } finally {
+    fs.writeFileSync(path.join(out, 'results.json'), JSON.stringify({schema:'math-p067-similar-steps-browser/1',testedCheckoutSha:sha,originalControls:true,seededLessonPositionOnly:false,chromium:browserVersion,viewport:STANDARD_DESKTOP_VIEWPORT,sources:P067_SOURCES,checks,observations,screenshots,errors},null,2)+'\n');
+    await restore?.close().catch(()=>{}); await learner?.close().catch(()=>{}); await browser?.close().catch(()=>{}); await origin?.close().catch(()=>{});
+  }
+}
+run().catch(e => { console.error(e.stack || e); process.exitCode = 1; });
diff --git a/tests/p9-p067-similar-steps.test.mjs b/tests/p9-p067-similar-steps.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..85d0830b374e50794fa9ac0ed5968e4147b47493
--- /dev/null
+++ b/tests/p9-p067-similar-steps.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {BRIDGES, sessionTaskFor} from '../dist/learning/bridges.js';
+import {ensureB39Ready} from '../dist/learning/phase4/async-batches.js';
+import * as original from '../dist/learning/phase5/b37-model.js';
+import {P067_SOURCES, p067SimilarStepsBinding, replayP067SimilarStepsEvidence, submittedP067SimilarStepsEvidence} from '../dist/learning/p067-similar-steps-evidence.js';
+
+const [source] = P067_SOURCES, context = {sessionId: source.sessionId, index: source.index};
+const task = sessionTaskFor(source.sessionId, source.index);
+const ordered = v => Array.isArray(v) ? v.map(ordered) : (v && typeof v === 'object' ? Object.fromEntries(Object.keys(v).sort((a,b)=>a.localeCompare(b,'en')).map(k=>[k,ordered(v[k])])) : v);
+const complete = (wrongFirst = false) => {
+  const m = original.initial(task);
+  if (wrongFirst) { m.value = '99999'; original.act(task, m, 'r37-step'); }
+  for (const s of task.steps) { m.value = String(s.value); original.act(task, m, 'r37-step'); }
+  return m;
+};
+
+test('P067 locks fingerprint', () => {
+  assert.equal(createHash('sha256').update(JSON.stringify(ordered(task))).digest('hex'), source.taskHash);
+  assert.equal(p067SimilarStepsBinding(task, context)?.nodeId, source.nodeId);
+  assert.equal(p067SimilarStepsBinding({...task, prompt: 'x'}, context), null);
+});
+test('P067 verifies steps and preserves failed attempt', () => {
+  const m = complete(true), before = structuredClone(m), p = replayP067SimilarStepsEvidence(task, m, context);
+  assert.equal(p?.steps.length, task.steps.length);
+  assert.equal(p?.failedSteps, 1);
+  assert.deepEqual(m, before);
+});
+test('P067 requires fresh Check and rejects tampered state', () => {
+  const good = complete(false), partial = original.initial(task);
+  partial.value = String(task.steps[0].value); original.act(task, partial, 'r37-step');
+  assert.equal(submittedP067SimilarStepsEvidence(task, partial, {attempts:[{value:partial}]}, context), null);
+  assert.equal(submittedP067SimilarStepsEvidence(task, good, {attempts:[{value:partial}]}, context), null);
+  assert.equal(submittedP067SimilarStepsEvidence(task, good, {attempts:[{value:partial},{value:good}]}, context)?.steps.length, task.steps.length);
+  for (const mut of [m => { m.history.length = 0; }, m => { m.board.index = 0; }, m => { m.issue = 'e'; }]) {
+    const c = structuredClone(good); mut(c); assert.equal(replayP067SimilarStepsEvidence(task, c, context), null);
+  }
+});
+test('P067 excludes practice and bridges', async () => {
+  await ensureB39Ready();
+  assert.equal(p067SimilarStepsBinding(task, {sessionId: source.sessionId, index: -1}), null);
+  for (const [id, b] of Object.entries(BRIDGES)) for (const [idx, rel] of b.tasks.entries()) if (rel?.type === 'x-r37-steps') assert.equal(p067SimilarStepsBinding(rel, {sessionId: id, index: idx}), null);
+});
