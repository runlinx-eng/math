index 0000000000000000000000000000000000000000..a37a977e37f6a71b2ddd14f640495e362e6f78e2
--- /dev/null
+++ b/dist/learning/p088-graph-crossings-evidence.js
@@ -0,0 +1,96 @@
+import {initial, inspect, valid} from './phase5/b39-model.js';
+import {
+  hasExactKeys,
+  isEvidenceContext,
+  latestSubmissionMatches,
+  matchesNativeEvidenceTask,
+  sameEvidence
+} from './evidence-contract.js';
+
+const sessionId = 'graph39';
+const nodeId = 'mt_Yw27nweoTj';
+const type = 'x-s39-graph';
+const common = {graph:'curve',xMin:-3,xMax:3,yMin:-4,yMax:5};
+const reviewed = {
+  1:{
+    taskHash:'bf7420bd91a1ca427da93ba9557927ff91fb0e9bc67e1c1835d2713fc48febf7',
+    task:{type,prompt:'曲线和横轴在哪里相遇？两边都找一找。',mode:'roots',
+      ...common,offset:-2,tolerance:0.16,targets:[-1.4142135623730951,1.4142135623730951]},
+    question:'在哪两处，曲线的高度和横轴同为 0？'
+  },
+  2:{
+    taskHash:'eb0ba02a834cb5dc63f5f7d0fbebaa18646bacf04a479eb664313b0efb117822',
+    task:{type,prompt:'曲线与另一条线在哪些位置相遇？',mode:'intersection',
+      ...common,offset:-4,tolerance:0.16,targets:[-1.5615528128088303,2.5615528128088303]},
+    question:'沿着两条线找一找，在哪两个横向位置，它们的高度一样？'
+  }
+};
+
+export const P088_SOURCES = Object.freeze(Object.entries(reviewed).map(([index,{taskHash}]) =>
+  Object.freeze({sessionId,index:Number(index),nodeId,type,taskHash})
+));
+
+export function p088GraphCrossingsBinding(task,context) {
+  if (!isEvidenceContext(context) || context.sessionId !== sessionId ||
+      !sameEvidence(task,reviewed[context.index]?.task) ||
+      !matchesNativeEvidenceTask(task,context,{type,nodeId})) return null;
+  return {nodeId,kind:'p088-graph-crossings',method:null,question:reviewed[context.index].question};
+}
+
+function sampledCursor(text,task) {
+  if (!/^-?(?:\d+(?:\.\d{1,8})?|\.\d{1,8})$/.test(text.trim())) return null;
+  const value = Number(text);
+  return value >= task.xMin && value <= task.xMax ? value : null;
+}
+
+export function replayP088GraphCrossingsEvidence(task,model,context) {
+  try {
+    const binding = p088GraphCrossingsBinding(task,context);
+    if (!binding || !hasExactKeys(model,Object.keys(initial(task))) || !valid(task,model) ||
+        model.issue !== '' || !model.history.length ||
+        Object.keys(model.history).length !== model.history.length) return null;
+
+    const marks = [];
+    const actions = [];
+    for (const event of model.history) {
+      if (!hasExactKeys(event,['a','i','v','w','c']) || event.i || event.w || event.c) return null;
+      const cursor = sampledCursor(event.v,task);
+      if (cursor === null) return null;
+      if (event.a === 'mark') {
+        marks.push(cursor);
+        actions.push({action:'mark',cursor});
+      } else if (event.a === 'undo') {
+        actions.push({action:'undo',removed:marks.pop() ?? null});
+      } else {
+        return null;
+      }
+    }
+
+    // At a crossing x² + offset = slope * x. Completing the square
+    // gives the two positions center ± sqrt(center² - offset).
+    const slope = task.mode === 'intersection' ? 1 : 0;
+    const center = slope/2;
+    const radius = Math.sqrt(center*center-task.offset);
+    const roots = [center-radius,center+radius];
+    const crossings = [];
+    for (const expected of roots) {
+      const close = marks.filter(x => Math.abs(x-expected) <= task.tolerance);
+      if (!close.length) return null;
+      const nearest = close.reduce((best,x) =>
+        Math.abs(x-expected) < Math.abs(best-expected) ? x : best);
+      const curveY = nearest*nearest+task.offset;
+      const lineY = slope === 0 ? 0 : nearest;
+      crossings.push({expected,marked:nearest,error:Math.abs(nearest-expected),curveY,lineY});
+    }
+
+    if (!sameEvidence(marks,model.board.marks) || !inspect(task,model).correct) return null;
+    return {binding,marks,crossings,slope,tolerance:task.tolerance,actions};
+  } catch {
+    return null;
+  }
+}
+
+export function submittedP088GraphCrossingsEvidence(task,model,record,context) {
+  if (!latestSubmissionMatches(model,record)) return null;
+  return replayP088GraphCrossingsEvidence(task,model,context);
+}
diff --git a/tests/p9-p088-graph-crossings-browser.cjs b/tests/p9-p088-graph-crossings-browser.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..5b5a4e62bc6a66a8f5dddcaefc5c4d8049613497
--- /dev/null
+++ b/tests/p9-p088-graph-crossings-browser.cjs
@@ -0,0 +1,261 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const {execFileSync} = require('node:child_process');
+const {createHash} = require('node:crypto');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.MATH_PLAYWRIGHT_MODULE || 'playwright');
+const {createOrigin, warmAndStop, capture} = require('./helpers/p9-basic-artifact.cjs');
+const {newDesktopContext, STANDARD_DESKTOP_VIEWPORT} = require('./helpers/standard-desktop-viewport.cjs');
+
+const root = path.resolve(__dirname, '..');
+const out = path.resolve(process.env.MATH_P088_ARTIFACTS || path.join(root, 'verification/p9-p088-graph-crossings'));
+const entry = name => import(pathToFileURL(path.join(root, name)).href);
+const sha = execFileSync('git', ['rev-parse', 'HEAD'], {cwd:root, encoding:'utf8'}).trim();
+const checks = [], observations = [], screenshots = [], errors = [];
+const ok = (value, label) => { assert.ok(value, label); checks.push(label); };
+
+function ordered(value) {
+  if (Array.isArray(value)) return value.map(ordered);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.keys(value).sort((a,b)=>a.localeCompare(b,'en'))
+      .map(key=>[key, ordered(value[key])]));
+  }
+  return value;
+}
+
+async function openControl(page, selector) {
+  const control = page.locator(selector);
+  assert.equal(await control.count(), 1, 'unique original control: ' + selector);
+  for (let i = 0; i < 8 && !(await control.isVisible()); i++) {
+    const closed = control.locator('xpath=ancestor::details[not(@open) and not(ancestor::details[not(@open)])]');
+    assert.equal(await closed.count(), 1);
+    await closed.locator(':scope > summary').click();
+  }
+  return control;
+}
+
+async function routePosition(page, origin, row) {
+  const url = origin.base + 'learn.html#' + row.id;
+  if (row.index === 1) {
+    ok((await page.goto(url))?.fromServiceWorker() === true, 'native graph lesson opens offline');
+    await page.waitForFunction(() => window.mathLesson?.snapshot()?.id === 'graph39');
+    const start = page.locator('[data-do="start"]');
+    if (await start.isVisible()) await start.click();
+    await (await openControl(page,'#extra-controls [data-xfield="cursor"]')).fill('1.5');
+    await (await openControl(page,'#extra-controls [data-x="s39-mark"]')).click();
+    await (await openControl(page,'#extra-controls [data-xfield="answer"]')).fill('-1.75');
+    await page.locator('#actions [data-do="check"]').click();
+    checks.push('the original prerequisite is completed with the actual cursor and answer');
+  }
+  await page.locator('#actions [data-do="next"]').click();
+  checks.push('native Next reaches position ' + row.index);
+  await page.waitForFunction(({id,index}) => {
+    const snap = window.mathLesson?.snapshot();
+    return snap?.id === id && snap.index === index;
+  },row);
+}
+
+async function run() {
+  fs.mkdirSync(out, {recursive:true});
+  const {P088_SOURCES, replayP088GraphCrossingsEvidence, submittedP088GraphCrossingsEvidence} =
+    await entry('dist/learning/p088-graph-crossings-evidence.js');
+  const {sessionTaskFor} = await entry('dist/learning/bridges.js');
+  const {inspect} = await entry('dist/learning/phase5/b39-model.js');
+  const {ensureB39Ready} = await entry('dist/learning/phase4/async-batches.js');
+  await ensureB39Ready();
+  const expected = [[-1.4,1.4],[-1.6,2.6]];
+  const cases = P088_SOURCES.map((source, i) => {
+    const {sessionId, index} = source;
+    return {source, id:sessionId, index, context:{sessionId,index},
+      task:sessionTaskFor(sessionId,index), marks:expected[i]};
+  });
+  const verified = [];
+  let origin, browser, learner, restore, page, browserVersion = null, phase = 'startup';
+
+  function proof(row, snap) {
+    return submittedP088GraphCrossingsEvidence(row.task, snap.model, snap.record, row.context);
+  }
+  async function observe(p, row, stage) {
+    const result = await capture(p, out, row.id + '-' + row.index, row, stage);
+    observations.push({
+      index: row.index, stage, attempts: result.attempts.length,
+      marks: result.model.board.marks, historyLength: result.model.history.length,
+      proof: proof(row, result), storage: result.storage
+    });
+    return result;
+  }
+  async function picture(p, name) {
+    await p.screenshot({path: path.join(out, name)});
+    screenshots.push(name);
+  }
+  async function click(p, selector) {
+    await (await openControl(p, selector)).click();
+  }
+
+  try {
+    origin = await createOrigin(root);
+    browser = await chromium.launch({
+      headless: true,
+      args: ['--use-angle=swiftshader','--enable-unsafe-swiftshader'],
+      ...(process.env.MATH_CHROMIUM_EXECUTABLE ? {executablePath:process.env.MATH_CHROMIUM_EXECUTABLE} : {})
+    });
+    browserVersion = browser.version();
+    learner = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow', acceptDownloads:true});
+    restore = await newDesktopContext(browser, {reducedMotion:'reduce', serviceWorkers:'allow'});
+    page = await learner.newPage();
+    const restorePage = await restore.newPage();
+    for (const p of [page, restorePage]) {
+      p.setDefaultTimeout(15000);
+      p.on('pageerror', error => errors.push(phase + ': ' + error.message));
+    }
+    for (const context of [learner, restore]) {
+      context.on('request', request => {
+        if (/^https?:/.test(request.url()) && !request.url().startsWith(origin.base)) {
+          errors.push('non-local request: ' + request.url());
+        }
+      });
+    }
+
+    const release = fs.readFileSync(path.join(root, 'dist/sw.js'), 'utf8').match(/const CACHE = '([^']+)'/)[1];
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    await restorePage.goto(origin.base + 'v2.html#trail');
+    await restorePage.locator('#main [data-do="import"]').first().waitFor();
+    await restorePage.evaluate(async () => Boolean(await navigator.serviceWorker.ready));
+    await restorePage.reload();
+    await restorePage.waitForFunction(() => !!navigator.serviceWorker.controller);
+    await warmAndStop(page, origin, release, ok, 'P088');
+
+    for (const row of cases) {
+      phase = row.id + ':' + row.index;
+      const tag = row.id + '-' + row.index;
+      await routePosition(page, origin, row);
+      const live = await page.evaluate(async ({id,index}) => {
+        const {sessionTaskFor} = await import('./learning/bridges.js');
+        const {LESSONS} = await import('./learning/catalog.js');
+        return {task:sessionTaskFor(id,index), nodeId:LESSONS[id].topicId};
+      }, row);
+      const digest = createHash('sha256').update(JSON.stringify(ordered(live.task))).digest('hex');
+      ok(live.nodeId === row.source.nodeId && digest === row.source.taskHash, tag + ' source fingerprint');
+      assert.deepEqual(live.task, row.task);
+      ok(await page.evaluate(() => innerWidth === 1920 && innerHeight === 1080), tag + ' standard viewport');
+
+      const action = name => click(page,'#extra-controls [data-x="s39-' + name + '"]');
+      const marks = page.locator('#extra-visual svg.s39-graph circle[fill="#c57c59"]');
+      const mark = async cursor => {
+        const slider = await openControl(page,'#extra-controls [data-xfield="cursor"]');
+        await slider.fill(String(cursor));
+        assert.equal(await slider.inputValue(),String(cursor));
+        await action('mark');
+      };
+      const check = () => click(page,'#actions [data-do="check"]');
+      await mark(row.marks[0]);
+      await mark(-1.5);
+      assert.equal(await marks.count(),2);
+      await check();
+      const wrong = await observe(page,row,'same-side-check');
+      ok(wrong.attempts.length === 1 && wrong.model.board.marks.every(n => n < 0) &&
+        !inspect(row.task,wrong.attempts[0].value).correct && !proof(row,wrong),
+      tag + ' two marks on the same side fail the actual Check');
+      await picture(page,tag + '-same-side.png');
+
+      await action('undo');
+      const undone = await observe(page,row,'undo');
+      assert.deepEqual(undone.model.board.marks,[row.marks[0]]);
+      ok(await marks.count() === 1, tag + ' native undo removes the last drawn dot');
+      await mark(row.marks[1]);
+      assert.equal(await marks.count(),2);
+      ok(await page.locator('#extra-visual .s39-second').count() === row.index-1,
+        tag + ' the correct graph and reference line are rendered');
+      const draft = await observe(page,row,'corrected-draft');
+      const replayed = replayP088GraphCrossingsEvidence(row.task,draft.model,row.context);
+      assert.deepEqual(replayed?.crossings.map(c => c.marked),row.marks);
+      ok(!proof(row,draft), tag + ' drawing the second crossing still requires a new Check');
+
+      await check();
+      const good = await observe(page,row,'correct-check');
+      const accepted = proof(row,good);
+      ok(good.attempts.length === 2 && inspect(row.task,good.attempts.at(-1).value).correct &&
+        accepted?.crossings.length === 2 && accepted.crossings.every(c => c.error < accepted.tolerance),
+      tag + ' actual latest Check preserves approximate crossings on both sides');
+      assert.deepEqual(accepted.actions[2],{action:'undo',removed:-1.5});
+      ok(await page.locator('#thinking-feedback').count() === 0, tag + ' candidate has no global registration');
+      await picture(page, tag + '-correct-check.png');
+
+      ok((await page.reload())?.fromServiceWorker() === true, tag + ' stopped-origin reload');
+      await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, row.index);
+      const reloaded = await observe(page, row, 'offline-reload');
+      assert.deepEqual(reloaded.model, good.model);
+      assert.deepEqual(reloaded.record, good.record);
+      assert.deepEqual(proof(row,reloaded), accepted);
+      checks.push(tag + ' raw model and both Checks survive reload');
+      verified.push({row, good, accepted});
+    }
+
+    phase = 'State-v2 backup';
+    await page.goto(origin.base + 'v2.html#trail');
+    await page.locator('#main [data-do="export"]').first().waitFor();
+    const saving = page.waitForEvent('download');
+    await page.locator('#main [data-do="export"]').first().click();
+    const bytes = fs.readFileSync(await (await saving).path());
+    const envelope = JSON.parse(bytes);
+    ok(envelope.app === 'math-explorer' && envelope.version === 2, 'real offline State-v2 export');
+    fs.writeFileSync(path.join(out, 'native-state-v2.json'), bytes);
+
+    async function upload(buffer, name) {
+      const chooser = restorePage.waitForEvent('filechooser');
+      await restorePage.locator('#main [data-do="import"]').first().click();
+      await (await chooser).setFiles({name, mimeType:'application/json', buffer});
+      await restorePage.waitForFunction(() => document.querySelector('#import-file')?.value === '');
+      return restorePage.locator('#toast').innerText();
+    }
+    ok((await upload(bytes, 'p088-backup.json')).includes('备份已合并'), 'fresh context imports the backup');
+    const restoredBytes = await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2'));
+    ok((await upload(bytes, 'p088-repeat.json')).includes('备份已合并'), 'repeat import succeeds');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'repeat import preserves exact bytes');
+    ok(!(await upload(Buffer.from('{'), 'p088-corrupt.json')).includes('备份已合并'), 'corrupt backup is rejected');
+    ok(await restorePage.evaluate(() => localStorage.getItem('math-explorer-v2')) === restoredBytes,
+      'failed import preserves exact bytes');
+    await restorePage.goto(origin.base + 'learn.html#' + cases.at(-1).id);
+    await restorePage.waitForFunction(id => window.mathLesson?.snapshot()?.id === id, cases.at(-1).id);
+    for (const {row, good, accepted} of verified) {
+      const imported = await observe(restorePage,row,'restored-backup');
+      assert.deepEqual(imported.model, good.model);
+      assert.deepEqual(imported.record, good.record);
+      assert.deepEqual(proof(row,imported), accepted);
+      checks.push(row.index + ' restored model, correction and evidence match exactly');
+    }
+
+    phase = 'Retry';
+    const last = verified.at(-1).row;
+    await page.goto(origin.base + 'learn.html#' + last.id);
+    await page.waitForFunction(i => window.mathLesson?.snapshot()?.index === i, last.index);
+    await click(page, '[data-do="p3-retry"]');
+    const retry = await observe(page, last, 'retry');
+    ok(retry.model.history.length === 0 && retry.attempts.length === 2 &&
+      proof(last,retry) === null, 'Retry keeps saved attempts and excludes the new blank draft');
+    ok(errors.length === 0, 'no non-local requests or page errors');
+    console.log('P088_CHROMIUM_OK ' + JSON.stringify({testedCheckoutSha:sha,chromium:browserVersion,checks:checks.length,captures:observations.length}));
+  } catch (error) {
+    errors.push(phase + ': ' + (error.stack || error));
+    await page?.screenshot({path:path.join(out, 'failure.png')}).catch(() => {});
+    throw error;
+  } finally {
+    fs.writeFileSync(path.join(out,'results.json'),JSON.stringify({
+      schema:'math-p088-graph-crossings-browser/1', testedCheckoutSha:sha,
+      originalControls:true, seededLessonPositionOnly:false, chromium:browserVersion,
+      viewport:STANDARD_DESKTOP_VIEWPORT, sources:P088_SOURCES,
+      checks, observations, screenshots, errors
+    },null,2)+'\n');
+    await restore?.close().catch(() => {});
+    await learner?.close().catch(() => {});
+    await browser?.close().catch(() => {});
+    await origin?.close().catch(() => {});
+  }
+}
+
+run().catch(error => { console.error(error.stack || error); process.exitCode = 1; });
diff --git a/tests/p9-p088-graph-crossings.test.mjs b/tests/p9-p088-graph-crossings.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..324443b020f5d13173ff1cff2345eca1c0b771d7
--- /dev/null
+++ b/tests/p9-p088-graph-crossings.test.mjs
@@ -0,0 +1,121 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {BRIDGES, sessionTaskFor} from '../dist/learning/bridges.js';
+import {ensureB39Ready} from '../dist/learning/phase4/async-batches.js';
+import * as original from '../dist/learning/phase5/b39-model.js';
+import {
+  P088_SOURCES,
+  p088GraphCrossingsBinding,
+  replayP088GraphCrossingsEvidence,
+  submittedP088GraphCrossingsEvidence
+} from '../dist/learning/p088-graph-crossings-evidence.js';
+
+await ensureB39Ready();
+const cases = P088_SOURCES.map((source,i) => {
+  const {sessionId,index} = source;
+  return {source,context:{sessionId,index},task:sessionTaskFor(sessionId,index),
+    marks:[[-1.4,1.4],[-1.6,2.6]][i]};
+});
+const replay = (row,model) => replayP088GraphCrossingsEvidence(row.task,model,row.context);
+const submit = (row,model,...versions) => submittedP088GraphCrossingsEvidence(row.task,model,
+  {attempts:versions.map(value => ({value:structuredClone(value)}))},row.context);
+
+function mark(row,model,cursor) {
+  model.cursor = String(cursor);
+  original.field(row.task,model,'cursor');
+  original.act(row.task,model,'s39-mark');
+}
+
+function complete(row,model = original.initial(row.task)) {
+  for (const cursor of row.marks) mark(row,model,cursor);
+  return model;
+}
+
+test('P088 binds both exact original crossing tasks and their fingerprints', () => {
+  for (const {source,task,context} of cases) {
+    const ordered = Object.fromEntries(Object.entries(task).sort(([a],[b]) => a.localeCompare(b,'en')));
+    assert.equal(createHash('sha256').update(JSON.stringify(ordered)).digest('hex'),source.taskHash);
+    assert.equal(p088GraphCrossingsBinding(task,context)?.nodeId,source.nodeId);
+    assert.equal(p088GraphCrossingsBinding({...task,offset:0},context),null);
+    assert.equal(p088GraphCrossingsBinding({...task,tolerance:0.5},context),null);
+  }
+});
+
+test('P088 independently finds crossings with the axis and with y = x', () => {
+  for (const row of cases) {
+    const model = complete(row), before = structuredClone(model);
+    const proof = replay(row,model);
+    assert.equal(proof?.tolerance,0.16);
+    assert.deepEqual(proof?.crossings.map(c => c.marked),row.marks);
+    for (const [i,{expected,marked,error,curveY,lineY}] of proof.crossings.entries()) {
+      assert.ok(Math.abs(expected-row.task.targets[i]) < 1e-12);
+      assert.equal(curveY,marked**2+row.task.offset);
+      assert.equal(lineY,row.task.mode === 'roots' ? 0 : marked);
+      assert.ok(error <= 0.16 && curveY !== lineY);
+    }
+    assert.deepEqual(model,before);
+  }
+});
+
+test('P088 rejects repeated marks on one side and requires a new Check after undo', () => {
+  for (const row of cases) {
+    const model = original.initial(row.task);
+    mark(row,model,row.marks[0]);
+    mark(row,model,-1.5);
+    const wrong = structuredClone(model);
+    assert.equal(submit(row,model,wrong),null);
+    original.act(row.task,model,'s39-undo');
+    mark(row,model,row.marks[1]);
+    assert.equal(submit(row,model,wrong),null);
+    const proof = submit(row,model,wrong,model);
+    assert.deepEqual(proof?.actions[2],{action:'undo',removed:-1.5});
+    assert.deepEqual(proof?.marks,row.marks);
+  }
+});
+
+test('P088 distinguishes approximate crossings from exploratory marks and out-of-window guesses', () => {
+  for (const row of cases) {
+    const model = original.initial(row.task);
+    mark(row,model,0);
+    mark(row,model,row.marks[0]);
+    mark(row,model,(row.marks[1]-0.3).toFixed(1));
+    assert.equal(replay(row,model),null);
+    mark(row,model,row.marks[1]);
+    const proof = replay(row,model);
+    assert.deepEqual(proof?.crossings.map(c => c.marked),row.marks);
+    assert.equal(proof?.marks.length,4);
+  }
+});
+
+test('P088 rejects altered artifacts and unsupported action histories', () => {
+  const [row] = cases;
+  const model = complete(row);
+  for (const change of [
+    m => { m.board.marks[0] = -1.42; },
