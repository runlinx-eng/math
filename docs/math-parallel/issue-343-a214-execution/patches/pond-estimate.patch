Subject: [PATCH] Verify pond-estimate for exact #343 positions

---
 dist/learning/a214-pond-estimate-evidence.js | 42 ++++++++++++++++++++
 tests/p9-a214-pond-estimate.test.mjs         | 28 +++++++++++++
 2 files changed, 70 insertions(+)
 create mode 100644 dist/learning/a214-pond-estimate-evidence.js
 create mode 100644 tests/p9-a214-pond-estimate.test.mjs

diff --git a/dist/learning/a214-pond-estimate-evidence.js b/dist/learning/a214-pond-estimate-evidence.js
new file mode 100644
index 0000000..ecbd8ac
--- /dev/null
+++ b/dist/learning/a214-pond-estimate-evidence.js
@@ -0,0 +1,42 @@
+// B-line development candidate for the exact #343 source positions below.
+import * as original from './phase4/b02-model.js';
+import {pondCells} from './phase4/geometry.js';
+import {
+  hasExactKeys, isEvidenceContext, latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence
+} from './evidence-contract.js';
+
+export const SOURCES = Object.freeze([
+  Object.freeze({sessionId: 'boundary', index: 2, nodeId: 'mt_eiB3-6pu6a',
+    type: 'x-pond', taskHash: 'd80cc0ef8f36ff31c095994d4fa7b74444399fa46008f31e99f1de63f779f231'}),
+]);
+
+function sourceFor(task, context) {
+  if (!isEvidenceContext(context)) return null;
+  const source = SOURCES.find(row => row.sessionId === context.sessionId && row.index === context.index);
+  return source && matchesNativeEvidenceTask(task, context, source) ? source : null;
+}
+
+export function binding(task, context) {
+  const source = sourceFor(task, context);
+  return source ? {nodeId: source.nodeId, method: null, question: '按覆盖不少于半格统一选格，估计面积。'} : null;
+}
+
+export function submitted(task, model, record, context) {
+  return latestSubmissionMatches(model, record) ? replay(task, model, context) : null;
+}
+
+export function replay(task, model, context) {
+  try {
+    const source = sourceFor(task, context);
+    if (!source || !hasExactKeys(model, Object.keys(original.initial(task))) ||
+        !original.valid(task, model) || !original.inspect(task, model).correct) return null;
+    const areas = pondCells(task);
+    const qualifying = areas.flatMap((area, i) => area >= 1 / 2 ? [i] : []);
+    const selected = [...model.tiles].sort((a, b) => a - b);
+    if (!sameEvidence(qualifying, selected) || model.unit !== 'cm²' || model.total !== selected.length) return null;
+    return {...source, method: null, selected, areas, threshold: 'at least half a unit square',
+      estimatedAreaSquareCentimetres: selected.length};
+  } catch {
+    return null;
+  }
+}
diff --git a/tests/p9-a214-pond-estimate.test.mjs b/tests/p9-a214-pond-estimate.test.mjs
new file mode 100644
index 0000000..94c2ace
--- /dev/null
+++ b/tests/p9-a214-pond-estimate.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import * as original from '../dist/learning/phase4/b02-model.js';
+import {taskFingerprint} from '../scripts/audit-evidence-expansion.mjs';
+import {SOURCES, binding, replay, submitted} from '../dist/learning/a214-pond-estimate-evidence.js';
+
+for (const source of SOURCES) {
+  test(source.sessionId + ':' + source.index + ' validates the native work and rejects counterexamples', () => {
+    const task = sessionTaskFor(source.sessionId, source.index);
+    assert.equal(taskFingerprint(task), source.taskHash);
+    assert.equal(binding(task, source)?.nodeId, source.nodeId);
+    assert.equal(binding({...task, prompt: task.prompt + '。'}, source), null);
+    assert.equal(binding(task, {...source, index: String(source.index)}), null);
+    const result = model => replay(task, model, source);
+
+    const good = original.example(task);
+    // Exact decimal vertices clipped with rational arithmetic, independently of the model.
+    const exact = [1, 2, 3, 6, 7, 8, 9, 10, 12, 13, 14, 15, 16, 19, 20, 21, 22, 27];
+    assert.deepEqual(result(good)?.selected, exact);
+    assert.equal(result(good)?.estimatedAreaSquareCentimetres, 18);
+    const wrong = {...good, tiles: [...exact.slice(1), 0]};
+    assert.equal(result({...good, unit: 'cm'}), null);
+    assert.equal(result(wrong), null);
+    assert.equal(submitted(task, good, {attempts: [{value: wrong}]}, source), null);
+    assert.ok(submitted(task, good, {attempts: [{value: wrong}, {value: structuredClone(good)}]}, source));
+  });
+}
