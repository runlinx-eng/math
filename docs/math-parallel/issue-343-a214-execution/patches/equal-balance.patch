+++ b/dist/learning/a214-equal-balance-evidence.js
@@ -0,0 +1,30 @@
+// #343: this native problem preserves its own balance releases and Check.
+import {sessionTaskFor} from './bridges.js';
+import {latestSubmissionMatches, matchesNativeEvidenceTask, sameEvidence} from './evidence-contract.js';
+import {replayP030BalanceEvidence} from './p030-native-balance-evidence.js';
+
+export const SOURCES = Object.freeze([Object.freeze({
+  sessionId: 'communicate38', index: 0, nodeId: 'mt_TMoHjMhRS2', type: 'x-balance',
+  taskHash: '23b489d4ffd0e44f95012b6e3868e234549400f9bc21a1cd441b3b6111e5edaa'
+})]);
+const [source] = SOURCES;
+const mathReference = {sessionId: 'equality', index: 2};
+
+export function binding(task, context) {
+  if (context?.sessionId !== source.sessionId || context.index !== source.index ||
+      !matchesNativeEvidenceTask(task, context, source)) return null;
+  const referenceTask = sessionTaskFor(mathReference.sessionId, mathReference.index);
+  return sameEvidence(task, referenceTask) ? {nodeId: source.nodeId, method: null,
+    question: '5 在左盘，2＋3 在右盘。检查实际记录的两边数量及等号。'} : null;
+}
+
+export function replay(task, model, context) {
+  if (!binding(task, context)) return null;
+  const referenceTask = sessionTaskFor(mathReference.sessionId, mathReference.index);
+  const math = replayP030BalanceEvidence(referenceTask, model, mathReference);
+  return math ? {...math, source: {...source, position: 'communicate38:0', method: null}} : null;
+}
+
+export function submitted(task, model, record, context) {
+  return latestSubmissionMatches(model, record) ? replay(task, model, context) : null;
+}
diff --git a/tests/p9-a214-equal-balance.test.mjs b/tests/p9-a214-equal-balance.test.mjs
new file mode 100644
index 0000000..5246e07
--- /dev/null
+++ b/tests/p9-a214-equal-balance.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {sessionTaskFor} from '../dist/learning/bridges.js';
+import * as original from '../dist/learning/phase4/b05-model.js';
+import {taskFingerprint} from '../scripts/audit-evidence-expansion.mjs';
+import {SOURCES, binding, replay, submitted} from '../dist/learning/a214-equal-balance-evidence.js';
+
+test('communicate38:0 supplies its own releases, values and equality symbol', () => {
+  const [source] = SOURCES;
+  const task = sessionTaskFor(source.sessionId, source.index);
+  assert.equal(taskFingerprint(task), source.taskHash);
+  assert.equal(binding(task, source)?.nodeId, source.nodeId);
+  const good = original.example(task);
+  const wrong = {...good, guess: 'right', runs: [{...good.runs[0], guess: 'right'}]};
+  good.runs.unshift(wrong.runs[0]);
+  const proof = submitted(task, good, {attempts: [{value: wrong}, {value: structuredClone(good)}]}, source);
+  assert.equal(proof?.source.position, 'communicate38:0');
+  assert.equal(proof?.source.nodeId, source.nodeId);
+  assert.equal(proof?.independentlyCalculatedLeft, 5);
+  assert.equal(proof?.independentlyCalculatedRight, 5);
+  assert.equal(proof?.observedOrderedOriginalReleaseSnapshots.length, 2);
+  assert.equal(replay(task, good, {sessionId: 'equality', index: 2}), null);
+  assert.equal(replay(task, {...good, runs: []}, source), null);
+  assert.equal(submitted(task, good, {attempts: [{value: wrong}]}, source), null);
+});
