+
+const modelKeys = ['hops', 'next', 'step', 'why'];
+function sourceFor(task, context) {
+  if (!isEvidenceContext(context)) return null;
+  const source = INTEGER_WALK_SOURCES.find(row =>
+    row.sessionId === context.sessionId && row.index === context.index);
+  return source && matchesNativeEvidenceTask(task, context, source) ? source : null;
+}
+
+export function integerWalkBinding(task, context = {}) {
+  const source = sourceFor(task, context);
+  return source ? {
+    nodeId: source.nodeId, method: null,
+    question: '从起点开始，每两个相邻记录相差多少？检查方向和步长是否一直相同。'
+  } : null;
+}
+
+export function replayIntegerWalkEvidence(task, model, context = {}) {
+  try {
+    const source = sourceFor(task, context);
+    if (!source || !hasExactKeys(model, modelKeys) || !original.valid(task, model) ||
+        model.next !== null || model.step !== (task.infer ? task.step : null)) return null;
+    const reason = task.reason ? (task.reason === 'ones' ? 'ones' : 'carry') : '';
+    if (model.why !== reason || model.hops.length !== task.count) return null;
+    const stations = [task.start, ...model.hops];
+    const steps = [];
+    for (const [index, destination] of model.hops.entries()) {
+      const origin = stations[index];
+      const delta = destination - origin;
+      if (!Number.isSafeInteger(destination) || delta !== task.step) return null;
+      steps.push({origin, destination, delta});
+    }
+    if (!original.inspect(task, model).correct) return null;
+    return {
+      nodeId: source.nodeId, taskHash: source.taskHash, method: null, stations, steps,
+      step: task.step, enteredStep: task.infer ? model.step : null,
+      selectedReason: task.reason ? model.why : null,
+      sourceRetainsUndoneStops: false
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function submittedIntegerWalkEvidence(task, model, record, context = {}) {
+  return latestSubmissionMatches(model, record) ? replayIntegerWalkEvidence(task, model, context) : null;
+}
diff --git a/tests/p9-a214-integer-walk.test.mjs b/tests/p9-a214-integer-walk.test.mjs
